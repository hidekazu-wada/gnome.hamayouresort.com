---
import BaseLayout from "../../assets/components/common/layout/BaseLayout.astro";
import PageHeader from "../../assets/components/common/pageHeader/PageHeader.astro";
import AnchorNav from "../../assets/components/common/anchorNav/AnchorNav.astro";
import Hero from "../../assets/components/pages/activity-detail/2-hero.astro";
import Overview from "../../assets/components/pages/activity-detail/3-overview.astro";
import Price from "../../assets/components/pages/activity-detail/4-price.astro";
import Flow from "../../assets/components/pages/activity-detail/5-flow.astro";
import Notes from "../../assets/components/pages/activity-detail/6-notes.astro";
import Reservation from "../../assets/components/pages/activity-detail/7-reservation.astro";
import Related from "../../assets/components/pages/activity-detail/8-related.astro";
import { activities } from "../../data/activities";

export function getStaticPaths() {
  return activities.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props;
// lead には改行用の <br> が含まれるため、meta 用にタグを落とす
const lead = activity.lead.replace(/<[^>]+>/g, "");
---

<BaseLayout
  title={`${activity.title} | アクティビティ | 西湖キャンプビレッジ・ノーム`}
  description={`${lead}。Gnomeで楽しめる「${activity.title}」の料金・所要時間・当日の流れをご紹介します。`}
  flush
  breadcrumb={[
    { label: "TOP", href: "/" },
    { label: "アクティビティ", href: "/activity/" },
    { label: activity.title },
  ]}
>
  <PageHeader
    titleEn={activity.titleEn}
    titleJa={activity.titleJa}
    lead={activity.lead}
  />
  <AnchorNav
    links={[
      { label: "概要", href: "#overview" },
      { label: "料金", href: "#price" },
      { label: "ご利用の流れ", href: "#flow" },
      { label: "注意事項", href: "#notes" },
      { label: "予約方法", href: "#reservation" },
    ]}
  />
  <Hero activity={activity} />
  <Overview activity={activity} />
  <Price activity={activity} />
  <Flow activity={activity} />
  <Notes activity={activity} />
  <Reservation />
  <Related activity={activity} />
</BaseLayout>

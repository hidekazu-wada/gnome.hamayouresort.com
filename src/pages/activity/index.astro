---
import BaseLayout from "../../assets/components/common/layout/BaseLayout.astro";
import PageHeader from "../../assets/components/common/pageHeader/PageHeader.astro";
import FilterBar from "../../assets/components/common/filter/FilterBar.astro";
import { filterGroups } from "../../data/activities";
import List from "../../assets/components/pages/activity/2-list.astro";
---

<BaseLayout
  title="アクティビティ | Gnome 湖のほとりのキャンプ場"
  description="自然を活かした20種類以上のアクティビティが楽しめます。Gnomeで体験できるアクティビティの一覧です。"
  flush
  breadcrumb={[{ label: "TOP", href: "/" }, { label: "アクティビティ" }]}
>
  <PageHeader
    titleEn="ACTIVITY"
    titleJa="アクティビティ"
    lead={'自然を活かした<br class="page-header__br-pc"><span class="page-header__lead-em">20種類以上</span>の<br class="page-header__br-sp">アクティビティが楽しめます'}
  />
  <FilterBar groups={filterGroups} />
  <List />
</BaseLayout>

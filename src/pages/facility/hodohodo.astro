---
import BaseLayout from "../../assets/components/common/layout/BaseLayout.astro";
import Hero from "../../assets/components/pages/facility/detail/1-hero.astro";
import Items from "../../assets/components/pages/facility/detail/2-items.astro";
import Spec from "../../assets/components/pages/facility/detail/3-spec.astro";
// お問い合わせセクションは一旦非表示（すぐ下のフッターと問い合わせ先が重複するため。
// LP的に別の問い合わせ先を置く可能性があるので消さずに残す）
// import Contact from "../../assets/components/pages/facility/detail/4-contact.astro";
import { facilityDetails } from "../../data/facilityDetails";

const detail = facilityDetails.hodohodo;
---

<BaseLayout
  title={`${detail.name} | 共有施設・設備 | 西湖キャンプビレッジ・ノーム`}
  description={detail.description}
  flush
  breadcrumb={[
    { label: "TOP", href: "/" },
    { label: "共有施設・設備", href: "/facility/" },
    { label: detail.name },
  ]}
>
  <Hero detail={detail} />
  <Items detail={detail} />
  <Spec detail={detail} />
  {/* <Contact /> 一旦非表示（上のコメント参照） */}
</BaseLayout>

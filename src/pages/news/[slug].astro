---
import BaseLayout from "../../assets/components/common/layout/BaseLayout.astro";
import PageHeader from "../../assets/components/common/pageHeader/PageHeader.astro";
import Article from "../../assets/components/pages/news-detail/1-article.astro";
import { newsItems } from "../../data/news";
import type { NewsBlock } from "../../data/news";

const isTextBlock = (
  block: NewsBlock,
): block is Extract<NewsBlock, { type: "text" }> => block.type === "text";

export function getStaticPaths() {
  return newsItems.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      // データの並び順で前後の記事へつなぐ
      prevHref: i > 0 ? `/news/${newsItems[i - 1].slug}/` : undefined,
      nextHref:
        i < newsItems.length - 1
          ? `/news/${newsItems[i + 1].slug}/`
          : undefined,
    },
  }));
}

const { item, prevHref, nextHref } = Astro.props;

// 本文の最初の段落を meta description にする。段落がなければタイトルで代用
const firstText = item.body.find(isTextBlock);
const excerpt = firstText?.text
  .replace(/<[^>]+>/g, "")
  .replace(/\s+/g, " ")
  .trim();
const description = excerpt
  ? excerpt.length > 110
    ? `${excerpt.slice(0, 110)}…`
    : excerpt
  : item.title;
---

<BaseLayout
  title={`${item.title} | Gnome 湖のほとりのキャンプ場`}
  description={description}
  ogType="article"
  flush
  breadcrumb={[
    { label: "TOP", href: "/" },
    { label: "お知らせ", href: "/news/" },
    { label: item.title },
  ]}
>
  <PageHeader
    titleEn="NEWS"
    titleJa="お知らせ"
    lead={item.date}
    leadVariant="date"
  />
  <Article item={item} prevHref={prevHref} nextHref={nextHref} />
</BaseLayout>

---
import BaseLayout from "../assets/components/common/layout/BaseLayout.astro";
import PageHeader from "../assets/components/common/pageHeader/PageHeader.astro";
import Map from "../assets/components/pages/area/1-map.astro";

const lead =
  'カテゴリで絞り込むと地図と一覧が連動します。<br class="page-header__br-sp">マーカーを選ぶと該当のお店の詳細が開きます。';
---

<BaseLayout
  title="周辺情報 | 西湖キャンプビレッジ・ノーム"
  description="Gnome周辺の病院・コンビニ・スーパー・飲食店・観光スポットをマップでご紹介します。"
  flush
  breadcrumb={[{ label: "TOP", href: "/" }, { label: "周辺情報" }]}
>
  <PageHeader
    titleEn="INFORMATION"
    titleJa="周辺情報"
    lead={lead}
    leadVariant="info"
  />
  <Map />
</BaseLayout>

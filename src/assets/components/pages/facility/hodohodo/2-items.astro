---
// メインSCSSファイルをインポート
import "../../../../../styles/main.scss";

import IconArrow from "../../../../images/facility/icon-arrow.svg";
import { hodohodoItems } from "../../../../../data/hodohodo";

// 利用料の遷移先は確定待ち
const FEE_URL = "#";
---

<section class="hodo-items">
  <div class="hodo-items__head">
    <h2 class="hodo-items__title">“ほどほどの森”でできること</h2>
    <div class="hodo-items__title-line" aria-hidden="true"></div>
  </div>

  <ul class="hodo-items__grid">
    {
      hodohodoItems.map((item) => (
        <li class="hodo-items__card">
          {item.photo ? (
            <img
              class="hodo-items__photo"
              src={item.photo.src}
              width={item.photo.width}
              height={item.photo.height}
              alt=""
              loading="lazy"
            />
          ) : (
            <div class="hodo-items__photo hodo-items__photo--empty" />
          )}

          <p class="hodo-items__card-title">{item.title}</p>

          <p class="hodo-items__text">
            {item.lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>

          {item.hasFee && (
            <a class="hodo-items__fee" href={FEE_URL}>
              <span>利用料</span>
              <img class="hodo-items__fee-icon" src={IconArrow.src} alt="" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../../styles/variables";
  @import "../../../../../styles/functions";
  @import "../../../../../styles/mixins";

  .hodo-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #fbf2dc;
    padding-top: spx(80);
    padding-bottom: spx(80);
    gap: spx(40);
    @include tablet-up {
      padding-top: ppx(120);
      padding-bottom: ppx(150);
      gap: ppx(40);
    }

    // 線が高さ0で描かれる分、gapから5pxを引く
    &__head {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(25);
      @include tablet-up {
        gap: ppx(25);
      }
    }

    &__title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.8;
      font-size: spx(42);
      letter-spacing: spx(2.1);
      margin-right: spx(-2.1);
      @include tablet-up {
        font-size: ppx(60);
        letter-spacing: ppx(3);
        margin-right: ppx(-3);
      }
    }

    &__title-line {
      width: spx(630);
      height: spx(5);
      background-repeat: repeat-x;
      background-image: repeating-linear-gradient(
        to right,
        #000 0,
        #000 #{spx(6)},
        transparent #{spx(6)},
        transparent #{spx(21)}
      );
      @include tablet-up {
        width: ppx(2000);
        height: ppx(5);
        background-image: repeating-linear-gradient(
          to right,
          #000 0,
          #000 #{ppx(6)},
          transparent #{ppx(6)},
          transparent #{ppx(21)}
        );
      }
    }

    // PCは4列（490×4＋間隔20×3＝2020）
    &__grid {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: center;
      padding-top: spx(30);
      gap: spx(50);
      @include tablet-up {
        width: ppx(2020);
        padding-top: ppx(30);
        gap: ppx(100) ppx(20);
      }
    }

    &__card {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      background-color: #fff;
      width: spx(630);
      padding: spx(15) 0 spx(40);
      border-radius: spx(30);
      gap: spx(20);
      filter: drop-shadow(0 #{spx(10)} #{spx(12)} rgba(0, 0, 0, 0.08));
      @include tablet-up {
        width: ppx(490);
        padding: ppx(15) 0 ppx(40);
        border-radius: ppx(30);
        gap: ppx(20);
        filter: drop-shadow(0 #{ppx(10)} #{ppx(12)} rgba(0, 0, 0, 0.08));
      }
    }

    &__photo {
      display: block;
      object-fit: cover;
      width: spx(590);
      height: spx(436);
      border-radius: spx(20);
      @include tablet-up {
        width: ppx(460);
        height: ppx(340);
        border-radius: ppx(20);
      }
    }

    // 写真が未支給のものはグレーで置いておく
    &__photo--empty {
      background-color: #c4c4c4;
    }

    &__card-title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #d6b156;
      text-align: center;
      line-height: 1.6;
      width: spx(590);
      font-size: spx(32);
      letter-spacing: spx(1.6);
      @include tablet-up {
        width: ppx(490);
        font-size: ppx(35);
        letter-spacing: ppx(1.75);
      }
    }

    &__text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      text-align: center;
      line-height: 1.6;
      width: spx(560);
      font-size: spx(25);
      @include tablet-up {
        width: ppx(440);
        font-size: ppx(26);
      }
    }

    // 下端に揃えたいのでmargin-autoで押し下げる
    &__fee {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: auto;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      transition: opacity 0.3s ease;
      padding: spx(26) spx(70);
      border-width: spx(4);
      gap: spx(10);
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      filter: drop-shadow(0 #{spx(10)} #{spx(12)} rgba(0, 0, 0, 0.08));
      @include tablet-up {
        padding: ppx(26) ppx(70);
        border-width: ppx(4);
        gap: ppx(10);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        filter: drop-shadow(0 #{ppx(10)} #{ppx(12)} rgba(0, 0, 0, 0.08));
      }

      @include hover {
        &:hover {
          opacity: 0.8;
        }
      }
    }

    &__fee-icon {
      display: block;
      width: spx(25);
      height: spx(25);
      @include tablet-up {
        width: ppx(25);
        height: ppx(25);
      }
    }
  }
</style>

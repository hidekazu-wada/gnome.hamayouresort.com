---
// メインSCSSファイルをインポート
import "../../../../../styles/main.scss";

import IconArrow from "../../../../images/facility/icon-arrow.svg";
import { hodohodoItems, hodohodoFee } from "../../../../../data/hodohodo";
---

<section class="hodo-items">
  <div class="hodo-items__head">
    {/* SPは「で」のあとで折る */}
    <h2 class="hodo-items__title">“ほどほどの森”で<br class="hodo-items__br-sp" />できること</h2>
    <div class="hodo-items__title-line" aria-hidden="true"></div>
  </div>

  <ul class="hodo-items__grid">
    {
      hodohodoItems.map((item) => (
        <li class="hodo-items__card">
          {item.photo ? (
            <img
              class="hodo-items__photo"
              src={item.photo.src}
              width={item.photo.width}
              height={item.photo.height}
              alt=""
              loading="lazy"
            />
          ) : (
            <div class="hodo-items__photo hodo-items__photo--empty" />
          )}

          <p class="hodo-items__card-title">{item.title}</p>

          <p class="hodo-items__text">
            {item.lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>

          {item.hasFee && (
            <button class="hodo-items__fee" type="button" data-fee-open>
              <span>利用料</span>
              <img class="hodo-items__fee-icon" src={IconArrow.src} alt="" />
            </button>
          )}
        </li>
      ))
    }
  </ul>

  {/* SPだけの施設詳細ボタン（Figma SPにのみ存在。リンク先は確定待ち） */}
  <a class="hodo-items__detail" href="/facility/">施設詳細はこちら</a>

  {/* 利用料モーダル（背景クリック・ESCで閉じる） */}
  <dialog class="hodo-items__fee-modal" data-fee-modal aria-label="利用料">
    <div class="hodo-items__fee-body">
      <div class="hodo-items__fee-row">
        <p class="hodo-items__fee-label">料金</p>
        <p class="hodo-items__fee-value">{hodohodoFee.price}</p>
      </div>
      <div class="hodo-items__fee-row">
        <p class="hodo-items__fee-label">注意事項</p>
        <ul class="hodo-items__fee-notes">
          {hodohodoFee.notes.map((note) => (
            <li class="hodo-items__fee-note">・{note}</li>
          ))}
        </ul>
      </div>
    </div>
  </dialog>
</section>

<script>
  // ClientRouter未使用のため直接初期化する
  const modal = document.querySelector<HTMLDialogElement>("[data-fee-modal]");
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-fee-open]");

  if (modal) {
    openers.forEach((btn) => {
      btn.addEventListener("click", () => modal.showModal());
    });

    // 背景（dialog自身）クリックで閉じる。中身クリックでは閉じない
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../../styles/variables";
  @import "../../../../../styles/functions";
  @import "../../../../../styles/mixins";

  .hodo-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #fbf2dc;
    padding-top: spx(50);
    padding-bottom: spx(80);
    gap: spx(40);
    @include tablet-up {
      padding-top: ppx(120);
      padding-bottom: ppx(150);
      gap: ppx(40);
    }

    // 線が高さ0で描かれる分、gapから5pxを引く
    &__head {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(25);
      }
    }

    &__title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.8;
      font-size: spx(46);
      letter-spacing: spx(2.1);
      margin-right: spx(-2.1);
      @include tablet-up {
        font-size: ppx(60);
        letter-spacing: ppx(3);
        margin-right: ppx(-3);
      }
    }

    &__title-line {
      width: spx(630);
      height: spx(5);
      background-repeat: repeat-x;
      background-image: repeating-linear-gradient(
        to right,
        #000 0,
        #000 #{spx(9)},
        transparent #{spx(9)},
        transparent #{spx(16)}
      );
      @include tablet-up {
        width: ppx(2000);
        height: ppx(5);
        background-image: repeating-linear-gradient(
          to right,
          #000 0,
          #000 #{ppx(11)},
          transparent #{ppx(11)},
          transparent #{ppx(21)}
        );
      }
    }

    // PCは4列（490×4＋間隔20×3＝2020）
    &__grid {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch; // 行内でカードの高さを揃える
      justify-content: center;
      width: spx(630);
      padding-top: spx(30);
      gap: spx(20) spx(10);
      @include tablet-up {
        width: ppx(2020);
        padding-top: ppx(30);
        gap: ppx(100) ppx(20);
      }
    }

    &__card {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      background-color: #fff;
      width: spx(310);
      padding: spx(10) 0 spx(25);
      border-radius: spx(20);
      gap: spx(13);
      filter: drop-shadow(0 #{spx(10)} #{spx(12)} rgba(0, 0, 0, 0.08));
      @include tablet-up {
        width: ppx(490);
        padding: ppx(15) 0 ppx(40);
        border-radius: ppx(30);
        gap: ppx(20);
        filter: drop-shadow(0 #{ppx(10)} #{ppx(12)} rgba(0, 0, 0, 0.08));
      }
    }

    &__photo {
      display: block;
      object-fit: cover;
      width: spx(290);
      height: spx(214);
      border-radius: spx(14);
      @include tablet-up {
        width: ppx(460);
        height: ppx(340);
        border-radius: ppx(20);
      }
    }

    // 写真が未支給のものはグレーで置いておく
    &__photo--empty {
      background-color: #c4c4c4;
    }

    &__card-title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #d6b156;
      text-align: center;
      line-height: 1.6;
      width: spx(290);
      font-size: spx(27);
      letter-spacing: spx(1.6);
      @include tablet-up {
        width: ppx(490);
        font-size: ppx(35);
        letter-spacing: ppx(1.75);
      }
    }

    &__text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      text-align: center;
      line-height: 1.6;
      word-break: break-all; // ダミーの◯連続を折り返す
      width: spx(270);
      font-size: spx(24);
      @include tablet-up {
        width: ppx(440);
        font-size: ppx(26);
      }
    }

    // 下端に揃えたいのでmargin-autoで押し下げる
    &__fee {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: auto;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.3s ease;
      padding: spx(13) spx(35);
      border-width: spx(4);
      gap: spx(10);
      font-size: spx(23);
      line-height: spx(23);
      letter-spacing: spx(1.15);
      filter: drop-shadow(0 #{spx(10)} #{spx(12)} rgba(0, 0, 0, 0.08));
      @include tablet-up {
        padding: ppx(26) ppx(70);
        border-width: ppx(4);
        gap: ppx(10);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        filter: drop-shadow(0 #{ppx(10)} #{ppx(12)} rgba(0, 0, 0, 0.08));
      }

      // ホバー: #d6b156にディゾルブ（指示書）
      @include hover {
        &:hover {
          background-color: #d6b156;
        }
      }
    }

    &__fee-icon {
      display: block;
      width: spx(25);
      height: spx(25);
      @include tablet-up {
        width: ppx(25);
        height: ppx(25);
      }
    }

    &__br-sp {
      @include tablet-up {
        display: none;
      }
    }

    // SPだけの施設詳細ボタン（473×96）
    &__detail {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8aad61;
      border: spx(4) solid #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      transition: background-color 0.3s ease;
      width: spx(473);
      margin-top: spx(30);
      padding: spx(31) 0;
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        display: none;
      }

      // ホバー: #d6b156にディゾルブ（指示書）
      @include hover {
        &:hover {
          background-color: #d6b156;
        }
      }
    }

    // 利用料モーダル（施設概要と同じ白カード2枚）
    &__fee-modal {
      margin: auto;
      border: none;
      outline: none;
      padding: 0;
      background: transparent;
      max-width: none;
      width: spx(630);
      @include tablet-up {
        width: ppx(1800);
      }

      &::backdrop {
        background: rgba(0, 0, 0, 0.6);
      }
    }

    &__fee-body {
      display: flex;
      flex-direction: column;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(20);
      }
    }

    &__fee-row {
      box-sizing: border-box;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      background-color: #fff;
      width: 100%;
      padding: spx(20) spx(30);
      border-radius: spx(20);
      gap: spx(15);
      @include tablet-up {
        padding: ppx(20) ppx(30);
        border-radius: ppx(20);
        gap: ppx(15);
      }
    }

    &__fee-label {
      flex-shrink: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #138185;
      line-height: 1.6;
      width: spx(150);
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        width: ppx(200);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__fee-value {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.6;
      width: spx(405);
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        width: ppx(1525);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    // SPは項目間を1行ぶんあける（Figmaの空行）
    &__fee-notes {
      display: flex;
      flex-direction: column;
      width: spx(405);
      gap: spx(43);
      @include tablet-up {
        width: ppx(1525);
        gap: 0;
      }
    }

    &__fee-note {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.6;
      word-break: break-all; // ダミーの◯連続を折り返す
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }
  }
</style>

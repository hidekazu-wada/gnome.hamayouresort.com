---
// メインSCSSファイルをインポート
import "../../../../../styles/main.scss";

import type { FacilityDetail } from "../../../../../data/facilityDetails";

// ほどほどの森／プレイパーク／Kokko の3ページで共有する
interface Props {
  detail: FacilityDetail;
}

const { detail } = Astro.props;

// 写真が未支給の施設はグレーの箱を出す。ドットは2枚以上のときだけ
const hasPhotos = detail.heroPhotos.length > 0;
const hasDots = detail.heroPhotos.length > 1;
---

<section class="hodo-hero">
  <div class="hodo-hero__head">
    {detail.nameSub && <p class="hodo-hero__title-sub">{detail.nameSub}</p>}
    <h1 class="hodo-hero__title">{detail.name}</h1>
    <div class="hodo-hero__title-line" aria-hidden="true"></div>
    {detail.badge && <p class="hodo-hero__badge">{detail.badge}</p>}
    {
      detail.notes && (
        <p class="hodo-hero__note">
          {detail.notes.map((note, i) => (
            <>
              {i > 0 && <br />}
              {note}
            </>
          ))}
        </p>
      )
    }
  </div>

  <div
    class:list={["hodo-hero__card", { "is-no-illust": !detail.illustration }]}
  >
    <div class="hodo-hero__visual">
      <!-- 写真は自動再生でディゾルブ切り替え -->
      <div class="hodo-hero__photos">
        {
          hasPhotos ? (
            detail.heroPhotos.map((photo, i) => (
              <img
                class:list={["hodo-hero__photo", { "is-active": i === 0 }]}
                src={photo.src}
                width={photo.width}
                height={photo.height}
                alt=""
                loading={i === 0 ? "eager" : "lazy"}
              />
            ))
          ) : (
            <div class="hodo-hero__photo hodo-hero__photo--empty is-active" />
          )
        }
      </div>

      {
        hasDots && (
          <ul class="hodo-hero__dots">
            {detail.heroPhotos.map((_, i) => (
              <li>
                <button
                  class:list={["hodo-hero__dot", { "is-active": i === 0 }]}
                  type="button"
                  data-index={i}
                  aria-label={`${i + 1}枚目の写真を表示`}
                />
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- キャンプサイトのイラスト（SPは写真の下、PCは本文カラムの上に重ねる） -->
    {
      detail.illustration && (
        <img class="hodo-hero__illust" src={detail.illustration.src} alt="" />
      )
    }

    <div class="hodo-hero__text">
      <p class="hodo-hero__lead">
        {detail.lead.map((line) => <span>{line}</span>)}
      </p>
      <p class="hodo-hero__body">{detail.body}</p>
    </div>
  </div>
</section>

<script>
  // ClientRouter未使用のため直接初期化する（泊まる詳細と同じディゾルブ）
  const hero = document.querySelector<HTMLElement>(".hodo-hero");

  if (hero) {
    const photos = Array.from(hero.querySelectorAll<HTMLElement>(".hodo-hero__photo"));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>(".hodo-hero__dot"));

    if (photos.length > 1) {
      let current = 0;
      let timer = 0;

      const show = (index: number) => {
        current = (index + photos.length) % photos.length;
        photos.forEach((photo, i) => photo.classList.toggle("is-active", i === current));
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === current));
      };

      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => show(current + 1), 5000);
      };

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          show(i);
          start();
        });
      });

      start();
    }
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../../styles/variables";
  @import "../../../../../styles/functions";
  @import "../../../../../styles/mixins";

  .hodo-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #d6b156;
    padding-top: spx(220);
    padding-bottom: spx(110);
    gap: spx(70);
    @include tablet-up {
      padding-top: ppx(220);
      padding-bottom: ppx(150);
      gap: ppx(70);
    }

    // 線が高さ0で描かれる分、gapから5pxを引く
    &__head {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(30);
      }
    }

    // 施設名の上に小さく乗る英字（Kokkoのみ）
    &__title-sub {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.6;
      // 見出しとの間はgap(30)ではなく詰めたいので相殺する
      margin-bottom: spx(-20);
      font-size: spx(28);
      letter-spacing: spx(2.8);
      margin-right: spx(-2.8);
      @include tablet-up {
        margin-bottom: ppx(-20);
        font-size: ppx(45);
        letter-spacing: ppx(4.5);
        margin-right: ppx(-4.5);
      }
    }

    &__title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.8;
      font-size: spx(56);
      letter-spacing: spx(5.6);
      margin-right: spx(-5.6);
      @include tablet-up {
        font-size: ppx(100);
        letter-spacing: ppx(10);
        margin-right: ppx(-10);
      }
    }

    &__title-line {
      width: spx(630);
      height: spx(5);
      background-repeat: repeat-x;
      background-image: repeating-linear-gradient(
        to right,
        #000 0,
        #000 #{spx(9)},
        transparent #{spx(9)},
        transparent #{spx(16)}
      );
      @include tablet-up {
        width: ppx(2000);
        height: ppx(5);
        background-image: repeating-linear-gradient(
          to right,
          #000 0,
          #000 #{ppx(11)},
          transparent #{ppx(11)},
          transparent #{ppx(21)}
        );
      }
    }

    &__badge {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #507425;
      text-align: center;
      white-space: nowrap;
      line-height: 1.6;
      margin-top: 0;
      padding: spx(30) spx(36.4) spx(30) spx(40);
      font-size: spx(36);
      letter-spacing: spx(3.6);
      @include tablet-up {
        padding: ppx(30) ppx(36.4) ppx(30) ppx(40);
        font-size: ppx(36);
        letter-spacing: ppx(3.6);
      }
    }

    &__note {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      text-align: center;
      line-height: 1.7;
      width: spx(630);
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        width: auto;
        white-space: nowrap;
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    // 白いカード
    &__card {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      background-color: #fffdf7;
      width: spx(650);
      padding: spx(25) spx(25) spx(50);
      border-radius: spx(30);
      gap: spx(40);
      @include tablet-up {
        flex-direction: row;
        align-items: flex-start;
        width: ppx(2000);
        padding: ppx(70) ppx(100) ppx(50);
        border-radius: ppx(50);
        gap: ppx(109);
      }
    }

    // 写真＋ドット（写真は重ねてディゾルブ）
    &__visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      gap: spx(40);
      @include tablet-up {
        gap: ppx(50);
      }
    }

    &__photos {
      position: relative;
      overflow: clip;
      width: spx(600);
      height: spx(450);
      border-radius: spx(30);
      @include tablet-up {
        width: ppx(976);
        height: ppx(732);
        border-radius: ppx(50);
      }
    }

    &__photo {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1s ease;
    }

    &__photo.is-active {
      opacity: 1;
    }

    // 写真が未支給の施設はグレーで置いておく（カードのアイテムと同じ扱い）
    &__photo--empty {
      background-color: #c4c4c4;
    }

    &__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(20);
      }
    }

    &__dot {
      display: block;
      border-radius: 50%;
      background-color: #cfcfcf;
      transition: background-color 0.3s ease;
      width: spx(25);
      height: spx(25);
      @include tablet-up {
        width: ppx(30);
        height: ppx(30);
      }
    }

    &__dot.is-active {
      background-color: #7f7f7f;
    }

    &__illust {
      display: block;
      width: spx(500);
      height: auto;
      margin-top: spx(-25); // ドット領域65−イラスト上40
      @include tablet-up {
        // 本文カラムの上に絶対配置（カード上端から少しはみ出す）
        position: absolute;
        top: ppx(-42);
        left: ppx(1222);
        width: ppx(641);
        margin-top: 0;
      }
    }

    // PCの padding-top はイラストを避けるための余白。
    // イラストを持たない施設（プレイパーク／Kokko）では不要なので詰める
    &__text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: spx(20);
      @include tablet-up {
        padding-top: ppx(190);
        gap: ppx(30);
      }
    }

    &__card.is-no-illust &__text {
      @include tablet-up {
        padding-top: 0;
      }
    }

    &__lead {
      display: flex;
      flex-direction: column;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #8aad61;
      line-height: 1.6;
      font-size: spx(40);
      @include tablet-up {
        font-size: ppx(55);
      }
    }

    &__body {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.8;
      width: spx(560);
      font-size: spx(27);
      @include tablet-up {
        width: ppx(715);
        font-size: ppx(30);
      }
    }
  }
</style>

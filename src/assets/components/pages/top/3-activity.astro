---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

// アセット
import PaperTexture from "../../../images/common/paper-texture.png";
import JoinPc from "../../../images/top/3-activity/join-pc.png";
import JoinSp from "../../../images/top/3-activity/join-sp.png";
import TreeTl from "../../../images/top/3-activity/tree-tl.svg";
import TreeBr from "../../../images/top/3-activity/tree-br.svg";
import Sunburst from "../../../images/top/3-activity/sunburst.png";
import Arrow from "../../../images/top/3-activity/arrow.svg";
import CardSup from "../../../images/top/3-activity/card-sup.jpg";
import CardFire from "../../../images/top/3-activity/card-fire.jpg";
import CardKayak from "../../../images/top/3-activity/card-kayak.jpg";
import CardForest from "../../../images/top/3-activity/card-forest.jpg";
import MoreArrow from "../../../images/top/3-activity/more-arrow.svg";

// アクティビティカード（後半はダミー：画像を使い回し）
const cards = [
  { label: "SUPツアー", vertical: "水の上を歩く", img: CardSup },
  { label: "キャンプファイヤー", vertical: "火と向き合う", img: CardFire },
  { label: "Hobie 足漕ぎカヤック", vertical: "自然から共生を学ぶ", img: CardKayak },
  { label: "樹海トレイル", vertical: "森に触れる", img: CardForest },
  { label: "カヌー体験", vertical: "湖を旅する", img: CardSup },
  { label: "星空観察", vertical: "夜空を見上げる", img: CardFire },
  { label: "フォレストヨガ", vertical: "森で整える", img: CardForest },
  { label: "湖畔サイクリング", vertical: "風を感じる", img: CardKayak },
  { label: "BBQ体験", vertical: "囲んで味わう", img: CardFire },
  { label: "早朝カヤック", vertical: "静寂を漕ぐ", img: CardKayak },
];
---

<section class="activity">
  <!-- 本体（クリーム地＋紙テクスチャ）を連続した下地にする -->
  <div class="activity__body">
    <div
      class="activity__texture"
      aria-hidden="true"
      style={`background-image: url(${PaperTexture.src});`}
    >
    </div>

    <!-- 木々装飾（左上・右下） -->
    <img class="activity__tree activity__tree--tl" src={TreeTl.src} alt="" />
    <img class="activity__tree activity__tree--br" src={TreeBr.src} alt="" />

    <div class="activity__inner">
      <!-- 見出し -->
      <div class="activity__title">
        <img class="activity__sunburst" src={Sunburst.src} alt="" />
        <div class="activity__title-group">
          <div class="activity__title-heading">
            <p class="activity__title-en">ACTIVITY</p>
            <p class="activity__title-ja">アクティビティ</p>
          </div>
          <p class="activity__lead">
            自然を活かした<span class="activity__lead-accent">20種類以上</span>の<br
              class="activity__lead-br"
            />アクティビティが楽しめます
          </p>
        </div>
      </div>

      <!-- カードスライダー -->
      <div class="activity__slider swiper">
        <div class="swiper-wrapper">
          {
            cards.map((card) => (
              <div class="swiper-slide activity__slide">
                <div class="activity__card">
                  <p class="activity__card-label">{card.label}</p>
                  <div class="activity__card-box">
                    <img
                      class="activity__card-img"
                      src={card.img.src}
                      alt={card.label}
                    />
                    <p class="activity__card-vertical">{card.vertical}</p>
                    <img class="activity__card-arrow" src={Arrow.src} alt="" />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="activity__pagination swiper-pagination"></div>

      <!-- MORE ボタン -->
      <a class="activity__more" href="#">
        <span class="activity__more-text">MORE</span>
        <img class="activity__more-arrow" src={MoreArrow.src} alt="" />
      </a>
    </div>
  </div>

  <!-- 上端: CONCEPTからの繋ぎ波（ミント→クリーム）。本体クリームの上に絶対配置 -->
  <div class="activity__join">
    <picture class="activity__join-picture">
      <source srcset={JoinPc.src} media="(min-width: 744px)" />
      <img class="activity__join-img" src={JoinSp.src} alt="" />
    </picture>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .activity {
    position: relative;
    // 上端の繋ぎ波が透明部分でCONCEPT側にはみ出す分をクリップ
    overflow: clip;

    // 上端の繋ぎ波（本体クリームの上に絶対配置。透明の下端は本体クリームが透ける）
    &__join {
      position: absolute;
      top: -1vw; // 上端の透明ブラシをクリップ線の外に出し、不透明ミントを上端に揃える
      left: 0;
      z-index: 2;
      width: 100%;
      line-height: 0;
      font-size: 0;
      pointer-events: none;
    }

    &__join-picture {
      display: block;
      width: 100%;
    }

    &__join-img {
      display: block;
      width: 100%;
      height: auto;
    }

    // 本体（クリーム地・連続した下地）
    &__body {
      position: relative;
      z-index: 1;
      background-color: #fffdf7;
    }

    // 背景の紙テクスチャ
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include desktop-up {
        background-size: ppx(200);
      }
    }

    // 木々装飾（左上・右下）※位置はコンテンツ実装時に精緻化
    &__tree {
      position: absolute;
      z-index: 1;
      display: block;
      height: auto;
      pointer-events: none;

      &--tl {
        left: 0;
        top: spx(520);
        width: spx(500);
        @include tablet-up {
          top: ppx(280 * 1.2);
          width: ppx(857 * 1.2);
        }
        @include desktop-up {
          top: ppx(280);
          width: ppx(857);
        }
      }

      &--br {
        right: 0;
        bottom: spx(18);
        width: spx(448);
        @include tablet-up {
          bottom: ppx(127 * 1.2);
          width: ppx(857 * 1.2);
        }
        @include desktop-up {
          bottom: ppx(127);
          width: ppx(857);
        }
      }
    }

    &__inner {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      // Figmaは繋ぎ枠95px＋セクション内60pxで、CONCEPT下端から153px
      padding: spx(153) spx(40) spx(192);
      @include tablet-up {
        padding: ppx(338 * 1.2) ppx(40 * 1.2) ppx(120 * 1.2);
      }
      @include desktop-up {
        padding: ppx(338) ppx(40) ppx(120);
      }
    }

    // 見出し（サンバースト＋ACTIVITY＋サブ見出し）
    &__title {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(10);
      @include tablet-up {
        gap: ppx(25 * 1.2);
      }
      @include desktop-up {
        gap: ppx(25);
      }
    }

    &__sunburst {
      display: block;
      width: spx(263);
      height: auto;
      @include tablet-up {
        width: ppx(263 * 1.2);
      }
      @include desktop-up {
        width: ppx(263);
      }
    }

    &__title-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(50 * 1.2);
      }
      @include desktop-up {
        gap: ppx(50);
      }
    }

    &__title-heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(5);
      @include tablet-up {
        gap: ppx(10 * 1.2);
      }
      @include desktop-up {
        gap: ppx(10);
      }
    }

    &__title-en {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.1;
      font-size: spx(79);
      letter-spacing: spx(3.95);
      @include tablet-up {
        font-size: ppx(105 * 1.2);
        letter-spacing: ppx(5.25 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(105);
        letter-spacing: ppx(5.25);
      }
    }

    &__title-ja {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.7;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(32 * 1.2);
        letter-spacing: ppx(1.6 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__lead {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.6;
      font-size: spx(40);
      letter-spacing: spx(2);
      @include tablet-up {
        font-size: ppx(55 * 1.2);
        letter-spacing: ppx(2.75 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(55);
        letter-spacing: ppx(2.75);
      }
    }

    &__lead-accent {
      color: #d6b156;
    }

    // サブ見出しの改行（SPのみ2行）
    &__lead-br {
      @include tablet-up {
        display: none;
      }
    }

    // カードスライダー
    &__slider {
      position: relative;
      box-sizing: border-box;
      align-self: stretch;
      margin-top: spx(310);
      // SPは左右いっぱいに（inner の padding を相殺し、カードのピークを画面端まで見せる）
      margin-left: spx(-40);
      margin-right: spx(-40);
      // カードのドロップシャドウがコンテナの overflow でクリップされないよう余白を確保
      padding: spx(16) spx(24) spx(44);
      @include tablet-up {
        margin-top: ppx(80 * 1.2);
        margin-left: 0;
        margin-right: 0;
        padding: ppx(16 * 1.2) ppx(24 * 1.2) ppx(44 * 1.2);
      }
      @include desktop-up {
        margin-top: ppx(80);
        // カード4枚(500×4+間隔45×3=2135) + シャドウ余白(24×2) に幅を絞り中央配置
        // → 5枚目はコンテナ外でクリップされ、デザイン同様両端に余白が残る
        width: ppx(2184);
        align-self: center;
        margin-left: auto;
        margin-right: auto;
        padding: ppx(16) ppx(24) ppx(44);
      }
    }

    &__slide {
      height: auto;
      @include desktop-up {
        // slidesPerView: "auto" 用の設計値固定幅
        width: ppx(500);
        margin-right: ppx(45);
      }
    }

    &__card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(22);
      @include tablet-up {
        gap: ppx(22 * 1.2);
      }
      @include desktop-up {
        gap: ppx(22);
      }
    }

    &__card-label {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.6;
      white-space: nowrap;
      font-size: spx(40);
      letter-spacing: spx(4);
      @include tablet-up {
        font-size: ppx(40 * 1.2);
        letter-spacing: ppx(4 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(40);
        letter-spacing: ppx(4);
      }
    }

    &__card-box {
      position: relative;
      width: 100%;
      aspect-ratio: 500 / 580;
      box-sizing: border-box;
      overflow: hidden;
      background-color: #fff;
      border: spx(10) solid #fff;
      border-radius: spx(40);
      box-shadow: spx(10) spx(15) spx(7) rgba(0, 0, 0, 0.25);
      @include tablet-up {
        border-width: ppx(10 * 1.2);
        border-radius: ppx(40 * 1.2);
        box-shadow: ppx(10 * 1.2) ppx(15 * 1.2) ppx(7 * 1.2) rgba(0, 0, 0, 0.25);
      }
      @include desktop-up {
        border-width: ppx(10);
        border-radius: ppx(40);
        box-shadow: ppx(10) ppx(15) ppx(7) rgba(0, 0, 0, 0.25);
      }
    }

    &__card-img {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__card-vertical {
      position: absolute;
      top: spx(115);
      left: spx(65);
      transform: translateX(-50%);
      margin: 0;
      writing-mode: vertical-rl;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
      font-size: spx(40);
      letter-spacing: spx(4);
      @include tablet-up {
        top: ppx(115 * 1.2);
        left: ppx(65 * 1.2);
        font-size: ppx(40 * 1.2);
        letter-spacing: ppx(4 * 1.2);
      }
      @include desktop-up {
        top: ppx(115);
        left: ppx(65);
        font-size: ppx(40);
        letter-spacing: ppx(4);
      }
    }

    &__card-arrow {
      position: absolute;
      right: spx(41);
      bottom: spx(24);
      width: spx(55);
      height: auto;
      @include tablet-up {
        right: ppx(41 * 1.2);
        bottom: ppx(24 * 1.2);
        width: ppx(55 * 1.2);
      }
      @include desktop-up {
        right: ppx(41);
        bottom: ppx(24);
        width: ppx(55);
      }
    }

    // ページネーション
    &__pagination {
      position: static !important;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: spx(16);
      margin-top: spx(70);
      @include tablet-up {
        gap: ppx(16 * 1.2);
        margin-top: ppx(70 * 1.2);
      }
      @include desktop-up {
        gap: ppx(16);
        margin-top: ppx(70);
      }
    }

    // MORE ボタン
    &__more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: spx(10);
      background-color: #8aad61;
      border: spx(4) solid #fff;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      padding: spx(35) spx(110);
      margin-top: spx(110);
      @include tablet-up {
        gap: ppx(10 * 1.2);
        border-width: ppx(4 * 1.2);
        box-shadow: 0 ppx(10 * 1.2) ppx(12 * 1.2) rgba(0, 0, 0, 0.08);
        padding: ppx(35 * 1.2) ppx(110 * 1.2);
        margin-top: ppx(110 * 1.2);
      }
      @include desktop-up {
        gap: ppx(10);
        border-width: ppx(4);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
        padding: ppx(35) ppx(110);
        margin-top: ppx(110);
      }

      @include hover {
        &:hover {
          opacity: 0.85;
        }
      }
    }

    &__more-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(26 * 1.2);
        letter-spacing: ppx(1.3 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    &__more-arrow {
      display: block;
      width: spx(28);
      height: auto;
      @include tablet-up {
        width: ppx(28 * 1.2);
      }
      @include desktop-up {
        width: ppx(28);
      }
    }
  }

  // Swiper が動的生成する bullet はグローバルで指定
  :global(.activity__pagination .swiper-pagination-bullet) {
    width: spx(18);
    height: spx(18);
    margin: 0 !important;
    background-color: #fff;
    opacity: 1;
    @include tablet-up {
      width: ppx(18 * 1.2);
      height: ppx(18 * 1.2);
    }
    @include desktop-up {
      width: ppx(18);
      height: ppx(18);
    }
  }

  :global(.activity__pagination .swiper-pagination-bullet-active) {
    background-color: #d6b156;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  const el = document.querySelector<HTMLElement>(".activity__slider");
  if (el) {
    const swiper = new Swiper(el, {
      modules: [Pagination],
      // デザイン同様、中央カードの左右に前後カードがのぞくようループさせる
      loop: true,
      slidesPerView: 1.4,
      spaceBetween: 12,
      centeredSlides: true,
      pagination: {
        el: ".activity__pagination",
        clickable: true,
      },
      breakpoints: {
        744: { slidesPerView: 2.3, spaceBetween: 16, centeredSlides: false },
        // PCはCSS固定幅（ppx(500)＋margin）で設計値どおりに表示
        1024: { slidesPerView: "auto", spaceBetween: 0, centeredSlides: false },
      },
    });
    // フォント・画像読み込み後に幅を再計測（vw幅の初期計測ずれ対策）
    window.addEventListener("load", () => swiper.update());
  }
</script>

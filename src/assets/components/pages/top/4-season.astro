---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import BgTexture from "../../../images/top/4-season/bg-texture.png";
import JoinPc from "../../../images/top/4-season/join-pc.svg";
// SPの繋ぎはユーザー支給のSVG
import JoinSp from "../../../images/top/4-season/join-sp.svg";
import Sunburst from "../../../images/top/3-activity/sunburst.png";
import MoreArrow from "../../../images/top/3-activity/more-arrow.svg";
import WinterMain from "../../../images/top/4-season/winter-main.jpg";
import WinterSub from "../../../images/top/4-season/winter-sub.jpg";
// イラストは四季ページ（/season/）と同じものを流用する
import IllustSpring from "../../../images/season/illust-spring.svg";
import IllustSummer from "../../../images/season/illust-summer.svg";
import IllustAutumn from "../../../images/season/illust-autumn.svg";
import IllustWinter from "../../../images/season/illust-winter.svg";

// 季節データ（写真は冬のみ実素材、春夏秋はダミー）
const seasons = [
  {
    key: "spring",
    ja: "春",
    en: "Spring",
    big: "Spring",
    caption: "芽吹きの季節、鮮やかな新緑",
    illust: IllustSpring.src,
  },
  {
    key: "summer",
    ja: "夏",
    en: "Summer",
    big: "Summer",
    caption: "湖畔で過ごす、爽やかな夏",
    illust: IllustSummer.src,
  },
  {
    key: "autumn",
    ja: "秋",
    en: "Autumn",
    big: "Autumn",
    caption: "紅葉に染まる、実りの秋",
    illust: IllustAutumn.src,
  },
  {
    key: "winter",
    ja: "冬",
    en: "Winter",
    big: "Winter",
    caption: "凛とした空気で、際立つ景色",
    illust: IllustWinter.src,
  },
];

// 初期表示の季節。ボタンの is-active と揃える
const INITIAL = "winter";
---

<section class="season">
  <!-- 本体（ライトグレー地＋粒子テクスチャ） -->
  <div class="season__body" style={`background-image: url(${BgTexture.src});`}>
    <div class="season__inner">
      <!-- 見出し -->
      <div class="season__title">
        <img class="season__sunburst" src={Sunburst.src} alt="" />
        <div class="season__title-group">
          <div class="season__title-heading">
            <p class="season__title-en">FOURR SEASON</p>
            <p class="season__title-ja">四季</p>
          </div>
          <p class="season__lead">春夏秋冬の大自然を楽しむ</p>
        </div>
      </div>

      <!-- 季節コンテンツ -->
      <div class="season__content">
        <!-- メイン画像＋大きな季節名＋キャプション -->
        <div class="season__main">
          <img class="season__main-img" src={WinterMain.src} alt="" />
          <div class="season__label">
            <p class="season__big" data-season-big>Winter</p>
            <p class="season__caption" data-season-caption>
              凛とした空気で、際立つ景色
            </p>
          </div>
        </div>

        <!-- サブ画像＋季節イラスト（SPは横並び / PCは絶対配置） -->
        <div class="season__row">
          <!-- 写真から選択中の季節のセクションへ飛ばす。hrefはボタン切替時に差し替える -->
          <a class="season__sub" href={`/season/#${INITIAL}`} data-season-link>
            <img class="season__sub-img" src={WinterSub.src} alt="" />
          </a>
          <div class="season__illust">
            {
              seasons.map((s) => (
                <img
                  class:list={[
                    "season__illust-img",
                    { "is-active": s.key === INITIAL },
                  ]}
                  src={s.illust}
                  alt={s.key === INITIAL ? `Enjoy ${s.en}` : ""}
                  data-season-illust={s.key}
                />
              ))
            }
          </div>
        </div>

        <!-- 季節ボタン -->
        <div class="season__buttons">
          {
            seasons.map((s) => (
              <button
                type="button"
                class:list={["season__btn", { "is-active": s.key === "winter" }]}
                data-season={s.key}
                data-big={s.big}
                data-caption={s.caption}
              >
                <span class="season__btn-ja">{s.ja}</span>
                <span class="season__btn-en">{s.en}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- MORE ボタン（四季を楽しむページへ） -->
      <a class="season__more" href="/season/">
        <span class="season__more-text">MORE</span>
        <img class="season__more-arrow" src={MoreArrow.src} alt="" />
      </a>
    </div>
  </div>

  <!-- 上端: ACTIVITYからの繋ぎ波（クリーム→グレー）。本体の上に絶対配置 -->
  <div class="season__join">
    <picture class="season__join-picture">
      <source srcset={JoinPc.src} media="(min-width: 744px)" />
      <img class="season__join-img" src={JoinSp.src} alt="" />
    </picture>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .season {
    position: relative;
    // 上端の繋ぎ波が透明部分でACTIVITY側にはみ出す分をクリップ
    overflow: clip;

    // 上端の繋ぎ波（本体グレーの上に絶対配置）
    //
    // 引き上げ量は「SVGの上端から波の描画が始まるまでの透明部分」より大きくすること。
    // 足りないとその透明部分から本体のグレー(#f2f2f2)が覗き、ACTIVITYのクリームとの間に
    // 明るい筋＝白線として見える。
    //   SP  join-sp.svg  viewBox 720x79   path開始 y=11.7012 → 1.63vw 必要
    //   PC  join-pc.svg  viewBox 2560x212 path開始 y=11.54   → 0.45vw 必要
    &__join {
      position: absolute;
      top: -1.7vw;
      left: 0;
      z-index: 2;
      width: 100%;
      line-height: 0;
      font-size: 0;
      pointer-events: none;
      // PCは透明部分が少ないので従来どおり。SPと同じだけ上げると波が浮いて見える
      @include tablet-up {
        top: -1vw;
      }
    }

    &__join-picture {
      display: block;
      width: 100%;
    }

    &__join-img {
      display: block;
      width: 100%;
      height: auto;
    }

    // 本体（ライトグレー地・連続した下地）
    // Figmaはグレーの粒子テクスチャのタイル（SP140 / PC200）
    &__body {
      position: relative;
      z-index: 1;
      background-color: #f2f2f2;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      @include tablet-up {
        background-size: ppx(200 * 1.2);
      }
      @include desktop-up {
        background-size: ppx(200);
      }
    }

    &__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: spx(140) spx(40) spx(120);
      @include tablet-up {
        min-height: ppx(800 * 1.2);
        padding: ppx(338 * 1.2) ppx(40 * 1.2) ppx(120 * 1.2);
      }
      @include desktop-up {
        min-height: ppx(800);
        padding: ppx(338) ppx(40) ppx(120);
      }
    }

    // 見出し（サンバースト＋FOURR SEASON＋サブ見出し）
    &__title {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(10);
      @include tablet-up {
        gap: ppx(25 * 1.2);
      }
      @include desktop-up {
        gap: ppx(25);
      }
    }

    &__sunburst {
      display: block;
      width: spx(263);
      height: auto;
      @include tablet-up {
        width: ppx(263 * 1.2);
      }
      @include desktop-up {
        width: ppx(263);
      }
    }

    &__title-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(50 * 1.2);
      }
      @include desktop-up {
        gap: ppx(50);
      }
    }

    &__title-heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(5);
      @include tablet-up {
        gap: ppx(10 * 1.2);
      }
      @include desktop-up {
        gap: ppx(10);
      }
    }

    &__title-en {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.1;
      white-space: nowrap;
      font-size: spx(79);
      letter-spacing: spx(3.95);
      @include tablet-up {
        font-size: ppx(105 * 1.2);
        letter-spacing: ppx(5.25 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(105);
        letter-spacing: ppx(5.25);
      }
    }

    &__title-ja {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.7;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(32 * 1.2);
        letter-spacing: ppx(1.6 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__lead {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.6;
      font-size: spx(40);
      letter-spacing: spx(2);
      // FigmaはPCだけ行送りが150%
      @include tablet-up {
        line-height: 1.5;
        font-size: ppx(55 * 1.2);
        letter-spacing: ppx(2.75 * 1.2);
      }
      @include desktop-up {
        line-height: 1.5;
        font-size: ppx(55);
        letter-spacing: ppx(2.75);
      }
    }

    // 季節コンテンツ（SP=縦積み / タブレット以上=PCと同じ絶対配置レイアウト）
    // ※絶対配置の全幅レイアウトのため ×1.2 だと横にあふれる。タブレットはPC比率のまま縮小表示する
    &__content {
      position: relative;
      align-self: stretch;
      width: 100%;
      // Figmaは見出しブロックとの間が60px
      margin-top: spx(60);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(70);
      @include tablet-up {
        display: block;
        height: ppx(1090);
        margin-top: ppx(70);
        // Group27 座標は section より約130px 右にオフセットした領域基準
        margin-left: ppx(90);
        margin-right: 0;
      }
    }

    // メイン画像
    &__main {
      position: relative;
      // SPは左右パディングを突き抜けて全幅表示
      width: 100vw;
      aspect-ratio: 1281 / 1021;
      overflow: visible;
      @include tablet-up {
        position: absolute;
        left: ppx(229);
        top: 0;
        width: ppx(1281);
        height: ppx(1021);
        aspect-ratio: auto;
        overflow: visible;
      }
    }

    &__main-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      @include tablet-up {
        border-radius: 0;
      }
    }

    // 大きな季節名＋キャプション（メイン画像に重なる）
    &__label {
      position: absolute;
      left: spx(35);
      bottom: spx(-85);
      z-index: 2;
      filter: drop-shadow(spx(4) spx(4) spx(4) rgba(0, 0, 0, 0.6));
      @include tablet-up {
        left: ppx(-229);
        bottom: auto;
        top: ppx(561);
        width: ppx(1000);
        filter: drop-shadow(ppx(5) ppx(5) ppx(4.5) rgba(0, 0, 0, 0.65));
      }
    }

    &__big {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      white-space: nowrap;
      font-size: spx(115);
      @include tablet-up {
        // タブレット以上は大文字表記（SPはキャピタライズのまま）
        text-transform: uppercase;
        font-size: ppx(305);
      }
    }

    &__caption {
      margin: spx(24) 0 0 spx(53);
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1.6;
      font-size: spx(24);
      letter-spacing: spx(1.2);
      @include tablet-up {
        margin: 0 0 0 ppx(110);
        font-size: ppx(55);
        letter-spacing: ppx(5.5);
      }
    }

    // サブ画像＋イラストの行（SP=横並び / タブレット以上=中身を絶対配置）
    &__row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: spx(20);
      // メイン画像下のラベルはみ出し分を含めた間隔（デザイン: 画像下端から127）
      margin-top: spx(57);
      width: 100%;
      @include tablet-up {
        margin-top: 0;
      }
      @include tablet-up {
        display: contents;
      }
    }

    // サブ画像
    // 選択中の季節のセクションへのリンク。写真がリンクだと気づきにくいので
    // ホバーでわずかに明るくして手がかりを出す
    &__sub {
      position: relative;
      display: block;
      flex-shrink: 0;
      width: spx(315);
      aspect-ratio: 1 / 1;
      overflow: hidden;
      transition: opacity 0.3s ease;

      @include hover {
        &:hover {
          opacity: 0.8;
        }
      }
      @include tablet-up {
        position: absolute;
        left: ppx(1677);
        top: ppx(238);
        width: ppx(646);
        height: ppx(647);
        aspect-ratio: auto;
      }
    }

    &__sub-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    // Enjoy Winter イラスト
    // 4季節ぶんのイラストを重ねてディゾルブで切り替える。
    // 縦横比が季節ごとにかなり違う（冬1.12 / 春1.61 / 秋1.63 / 夏1.98）ので、
    // 幅をそろえて下端を基準に重ね、枠の高さはいちばん背の高い冬に合わせる
    &__illust {
      position: relative;
      flex-shrink: 0;
      width: spx(305);
      aspect-ratio: 480 / 430;
      // タブレットは0.9掛けで右上へ（下の画像とPC同等の間隔を確保）
      @include tablet-up {
        position: absolute;
        left: ppx(1837);
        top: ppx(-190);
        width: ppx(470 * 0.9);
        z-index: 2;
      }
      @include desktop-up {
        left: ppx(1660);
        top: -8vw; // 実機確認による調整
        width: ppx(470);
      }
    }

    &__illust-img {
      position: absolute;
      left: 0;
      bottom: 0;
      display: block;
      width: 100%;
      height: auto;
      opacity: 0;
      transition: opacity 0.6s ease;

      &.is-active {
        opacity: 1;
      }
    }

    // MORE ボタン（ACTIVITYセクションと同じ体裁）
    &__more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: spx(10);
      background-color: #8aad61;
      border: spx(4) solid #fff;
      border-radius: 999px;
      text-decoration: none;
      transition: background-color 0.3s ease;
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      padding: spx(35) spx(110);
      margin-top: spx(106);
      @include tablet-up {
        gap: ppx(10 * 1.2);
        border-width: ppx(4 * 1.2);
        box-shadow: 0 ppx(10 * 1.2) ppx(12 * 1.2) rgba(0, 0, 0, 0.08);
        padding: ppx(35 * 1.2) ppx(110 * 1.2);
        margin-top: ppx(106 * 1.2);
      }
      @include desktop-up {
        gap: ppx(10);
        border-width: ppx(4);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
        padding: ppx(35) ppx(110);
        margin-top: ppx(106);
      }

      @include hover {
        &:hover {
          background-color: #d6b156;
        }
      }
    }

    &__more-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(26 * 1.2);
        letter-spacing: ppx(1.3 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    &__more-arrow {
      display: block;
      width: spx(28);
      height: auto;
      @include tablet-up {
        width: ppx(28 * 1.2);
      }
      @include desktop-up {
        width: ppx(28);
      }
    }

    // 季節ボタン
    &__buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: spx(20) spx(35);
      width: spx(595);
      max-width: 100%;
      @include tablet-up {
        position: absolute;
        left: ppx(1677);
        top: ppx(970);
        width: ppx(648);
        gap: ppx(20);
        justify-content: flex-start;
      }
    }

    &__btn {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: spx(15);
      width: calc(50% - #{spx(17.5)});
      padding: spx(30) spx(20);
      border: spx(4) solid #000;
      border-radius: 999px;
      background-color: transparent;
      cursor: pointer;
      transition:
        background-color 0.2s,
        color 0.2s;
      @include tablet-up {
        width: ppx(314);
        gap: ppx(15);
        padding: ppx(35) ppx(90);
        border-width: ppx(4);
      }

      // アクティブ（選択中）
      &.is-active {
        background-color: #000;
      }
      &.is-active .season__btn-ja,
      &.is-active .season__btn-en {
        color: #fff;
      }

      @include hover {
        &:hover {
          background-color: #fff;
        }
        &.is-active:hover {
          background-color: #000;
        }
      }
    }

    &__btn-ja {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      // Figma の leading-[26px] に合わせる（ボタンの縦太りを防ぐ）
      line-height: spx(24);
      font-size: spx(30);
      letter-spacing: spx(1.5);
      @include tablet-up {
        line-height: ppx(26);
        font-size: ppx(36);
        letter-spacing: ppx(1.8);
      }
    }

    &__btn-en {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      line-height: spx(24);
      font-size: spx(22);
      letter-spacing: spx(1.1);
      @include tablet-up {
        line-height: ppx(26);
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }
  }
</style>

<script>
  // 季節ボタンで大きな季節名・キャプション・イラスト・写真のリンク先を切り替え
  // ※写真は現状すべて冬のダミー（春夏秋の実素材は後で差し替え）
  const buttons =
    document.querySelectorAll<HTMLButtonElement>(".season__btn");
  const bigEl = document.querySelector<HTMLElement>("[data-season-big]");
  const captionEl =
    document.querySelector<HTMLElement>("[data-season-caption]");
  const illusts =
    document.querySelectorAll<HTMLImageElement>("[data-season-illust]");
  const subLink = document.querySelector<HTMLAnchorElement>("[data-season-link]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.season || "";
      buttons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      if (bigEl) bigEl.textContent = btn.dataset.big || "";
      if (captionEl) captionEl.textContent = btn.dataset.caption || "";

      // イラストはCSSのopacityでディゾルブする
      illusts.forEach((img) => {
        const on = img.dataset.seasonIllust === key;
        img.classList.toggle("is-active", on);
        // 読み上げ対象は表示中の1枚だけにする
        img.alt = on ? `Enjoy ${btn.dataset.big || ""}` : "";
      });

      // 写真のリンク先も選択中の季節に合わせる
      if (subLink) subLink.href = `/season/#${key}`;
    });
  });
</script>

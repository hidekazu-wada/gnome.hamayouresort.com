---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

// アセット
import PaperTexture from "../../../images/common/paper-texture.png";
import MapPc from "../../../images/top/8-access/map-pc.png";
import MapSp from "../../../images/top/8-access/map-sp.png";
import ArrowWhite from "../../../images/top/6-information/arrow-white.svg";

// 経路案内リンク（Figmaデザイン指定のGoogleマップURL）
const routeUrl =
  "https://www.google.com/maps/place/%E8%A5%BF%E6%B9%96%E3%82%AD%E3%83%A3%E3%83%B3%E3%83%97%E3%83%93%E3%83%AC%E3%83%83%E3%82%B8%E3%83%BB%E3%83%8E%E3%83%BC%E3%83%A0+Saiko+Camp+Village+GNOME/@35.5033262,138.6807858,1407m/data=!3m2!1e3!4b1!4m9!3m8!1s0x601be1ab8d8c9bbd:0x3a1367f1b176996a!5m2!4m1!1i2!8m2!3d35.5033219!4d138.6833607!16s%2Fg%2F11b7ynnrbp?entry=ttu&g_ep=EgoyMDI2MDYyOS4wIKXMDSoASAFQAw%3D%3D";

// Googleマップ埋め込み（航空写真＋ラベル表示、施設座標にピン）
const embedUrl =
  "https://maps.google.com/maps?q=35.5033219,138.6833607&t=h&z=14&hl=ja&output=embed";
---

<section class="access" id="access">
  <!-- 背景の紙テクスチャ -->
  <div
    class="access__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <!-- 日本地図（山梨ハイライト＋経路ドット線入り、セクション全面） -->
  <picture class="access__map">
    <source srcset={MapPc.src} media="(min-width: 744px)" />
    <img class="access__map-img" src={MapSp.src} alt="" />
  </picture>

  <!-- 透かし文字 -->
  <p class="access__watermark" aria-hidden="true">ACCESS</p>

  <div class="access__content">
    <div class="access__head">
      <!-- 住所（hrefなしaタグ: Chromeモバイルの自動リンク検出対策） -->
      <a class="access__address no-link">
        〒401-0332<br class="access__br-sp" />
        山梨県南都留郡富士河口湖町西湖１０３０
      </a>
      <a
        class="access__route"
        href={routeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="access__route-text">経路案内</span>
        <img class="access__route-arrow" src={ArrowWhite.src} alt="" />
      </a>
    </div>

    <!-- Googleマップ埋め込み -->
    <div class="access__gmap">
      <iframe
        class="access__gmap-iframe"
        src={embedUrl}
        title="西湖キャンプビレッジGNOMEの地図"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
      >
      </iframe>
    </div>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .access {
    position: relative;
    overflow: clip;
    background-color: #bee0e1;
    height: spx(1727);
    @include tablet-up {
      height: ppx(2184);
    }

    // 背景の紙テクスチャ
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include desktop-up {
        background-size: ppx(200);
      }
    }

    // 日本地図（セクション全面と同サイズの透過PNG）
    &__map {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      pointer-events: none;
    }

    &__map-img {
      display: block;
      width: 100%;
      height: 100%;
    }

    // 透かし文字
    &__watermark {
      position: absolute;
      z-index: 2;
      left: spx(30);
      top: 0;
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      opacity: 0.5;
      line-height: 1.7;
      white-space: nowrap;
      font-size: spx(130);
      @include tablet-up {
        left: ppx(65);
        top: ppx(-46);
        font-size: ppx(305);
      }
    }

    // コンテンツ（住所＋経路案内＋マップ）
    &__content {
      position: absolute;
      z-index: 2;
      top: spx(193);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(30);
      @include tablet-up {
        top: ppx(395);
        left: ppx(290);
        transform: none;
        align-items: flex-start;
        gap: ppx(37);
      }
    }

    &__head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(20);
      @include tablet-up {
        flex-direction: row;
        gap: ppx(50);
      }
    }

    &__address {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.7;
      white-space: nowrap;
      font-size: spx(31);
      letter-spacing: spx(1.55);
      @include tablet-up {
        font-size: ppx(34);
        letter-spacing: ppx(1.7);
      }
    }

    // Chromeモバイルの自動リンク検出対策
    .no-link {
      text-decoration: none;
      pointer-events: none;
      color: inherit;
    }

    &__br-sp {
      @include tablet-up {
        display: none;
      }
    }

    // 経路案内ボタン
    &__route {
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: spx(10);
      width: spx(413);
      padding: spx(35) spx(40);
      border: spx(6) solid #fff;
      border-radius: 999px;
      background-color: #000;
      text-decoration: none;
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        gap: ppx(10);
        width: ppx(413);
        padding: ppx(35) ppx(40);
        border-width: ppx(6);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      @include hover {
        &:hover {
          opacity: 0.8;
        }
      }
    }

    &__route-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      white-space: nowrap;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    &__route-arrow {
      display: block;
      width: spx(25);
      height: auto;
      @include tablet-up {
        width: ppx(25);
      }
    }

    // Googleマップ（白枠）
    &__gmap {
      box-sizing: border-box;
      width: spx(617);
      height: spx(489);
      border: spx(8) solid #fff;
      border-radius: spx(40);
      overflow: hidden;
      @include tablet-up {
        width: ppx(1378);
        height: ppx(686);
        border-width: ppx(8);
        border-radius: ppx(40);
      }
    }

    &__gmap-iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: none;
    }
  }
</style>

---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import JoinPc from "../../../images/top/5-stay/join-pc.png";
import JoinSp from "../../../images/top/5-stay/join-sp.png";
import Sunburst from "../../../images/top/3-activity/sunburst.png";
import BadgeFrame from "../../../images/top/5-stay/badge-frame.svg";
import Arrow from "../../../images/top/5-stay/arrow.svg";
import MoreArrow from "../../../images/top/3-activity/more-arrow.svg";
import BottomPhoto from "../../../images/top/5-stay/bottom-photo.png";
import BottomPhotoSp from "../../../images/top/5-stay/bottom-photo-sp.png";
import Card1 from "../../../images/top/5-stay/card1.jpg";
import Card2 from "../../../images/top/5-stay/card2.jpg";
import Card3 from "../../../images/top/5-stay/card3.jpg";
import Card4 from "../../../images/top/5-stay/card4.jpg";
import Card5 from "../../../images/top/5-stay/card5.jpg";
import Card6 from "../../../images/top/5-stay/card6.jpg";
import Card7 from "../../../images/top/5-stay/card7.jpg";
import Card8 from "../../../images/top/5-stay/card8.jpg";

// 宿泊サイトカード（写真は Figma ダミー）
const cards = [
  { photo: Card1, badgeTop: "人気", badgeBottom: "No,1", title1: "木々に囲まれた", title2: "林間サイト", price: "9,350", code: "F-1", tags: ["区画サイト", "最大5名", "林間", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー×"] },
  { photo: Card2, badgeTop: "", badgeBottom: "湖畔沿い", title1: "水の音に癒される", title2: "湖畔サイト", price: "7,700", code: "", tags: ["フリーサイト", "最大5名", "湖畔沿い", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー△"] },
  { photo: Card3, badgeTop: "最大", badgeBottom: "15名", title1: "大人数で楽しめる", title2: "グループサイト", price: "19,800", code: "G-1", tags: ["区画サイト", "最大15名", "林間", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー◯"] },
  { photo: Card4, badgeTop: "最大", badgeBottom: "12名", title1: "少人数グループなら", title2: "ダブルサイト", price: "18,700", code: "D-1", tags: ["区画サイト", "最大12名", "林間", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー◯"] },
  { photo: Card5, badgeTop: "", badgeBottom: "最安", title1: "平日限定", title2: "おまかせサイト", price: "3,300", code: "", tags: ["フリーサイト", "最大3名", "林間", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー×"] },
  { photo: Card6, badgeTop: "ママに", badgeBottom: "大人気", title1: "心落ち着く空間の", title2: "ゲルテント", price: "19,800", code: "", tags: ["区画サイト", "最大8名", "林間", "ACあり", "車両乗入×", "ペット×", "キャンピングカー×"] },
  { photo: Card7, badgeTop: "屋根付き", badgeBottom: "デッキ", title1: "限りなく外に近い", title2: "トレーラーハウス", price: "18,700", code: "", tags: ["キャビン", "最大4名", "林間", "ACなし", "車両乗入×", "ペット×", "キャンピングカー×"] },
  { photo: Card8, badgeTop: "初心者に", badgeBottom: "おすすめ", title1: "場所を指定できる", title2: "区画サイト", price: "9,350", code: "R-1", tags: ["区画サイト", "最大5名", "林間", "ACなし", "車両乗入◯", "ペット◯", "キャンピングカー×"] },
];
---

<section class="stay">
  <!-- 本体（ほぼ白の地） -->
  <div class="stay__body">
    <div class="stay__inner">
      <!-- 見出し -->
      <div class="stay__title">
        <img class="stay__sunburst" src={Sunburst.src} alt="" />
        <div class="stay__title-group">
          <div class="stay__title-heading">
            <p class="stay__title-en">STAY</p>
            <p class="stay__title-ja">泊まる</p>
          </div>
          <p class="stay__lead">豊富な宿泊スタイルから<br class="stay__lead-br" />選べます</p>
        </div>
      </div>

      <!-- カードグリッド -->
      <div class="stay__grid">
        {
          cards.map((card) => (
            <article class="stay__card">
              <div class="stay__card-photo">
                <img class="stay__card-img" src={card.photo.src} alt="" />
                <div class="stay__card-badge">
                  <img class="stay__card-badge-frame" src={BadgeFrame.src} alt="" />
                  <span class="stay__card-badge-text">
                    {card.badgeTop && (
                      <span class="stay__card-badge-top">{card.badgeTop}</span>
                    )}
                    <span class="stay__card-badge-bottom">{card.badgeBottom}</span>
                  </span>
                </div>
                {card.code && <span class="stay__card-code">{card.code}</span>}
              </div>

              <div class="stay__card-body">
                <div class="stay__card-info">
                  <h3 class="stay__card-title">
                    {card.title1}
                    <br />
                    {card.title2}
                  </h3>
                  <div class="stay__card-tags">
                    {card.tags.map((t) => (
                      <span class="stay__card-tag">{t}</span>
                    ))}
                  </div>
                </div>

                <div class="stay__card-price">
                  <p class="stay__card-price-text">
                    <span class="stay__card-price-amount">¥{card.price}〜</span>
                    <span class="stay__card-price-unit">／1泊</span>
                  </p>
                  <img class="stay__card-arrow" src={Arrow.src} alt="" />
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- MORE ボタン -->
      <a class="stay__more" href="/stay/">
        <span class="stay__more-text">MORE</span>
        <img class="stay__more-arrow" src={MoreArrow.src} alt="" />
      </a>

</div>

    <!-- 最下部の大きな写真（全幅・SP/PCで出し分け） -->
    <div class="stay__bottom">
      <picture class="stay__bottom-picture">
        <source srcset={BottomPhoto.src} media="(min-width: 744px)" />
        <img class="stay__bottom-img" src={BottomPhotoSp.src} alt="" />
      </picture>
    </div>
  </div>

  <!-- 上端: FOURR SEASONからの繋ぎ波（グレー→白）。本体の上に絶対配置 -->
  <div class="stay__join">
    <picture class="stay__join-picture">
      <source srcset={JoinPc.src} media="(min-width: 744px)" />
      <img class="stay__join-img" src={JoinSp.src} alt="" />
    </picture>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .stay {
    position: relative;
    overflow: clip;

    // 上端の繋ぎ波（本体の上に絶対配置）
    &__join {
      position: absolute;
      top: -1vw;
      left: 0;
      z-index: 2;
      width: 100%;
      line-height: 0;
      font-size: 0;
      pointer-events: none;
    }

    &__join-picture {
      display: block;
      width: 100%;
    }

    &__join-img {
      display: block;
      width: 100%;
      height: auto;
    }

    // 本体（ほぼ白の地）
    &__body {
      position: relative;
      z-index: 1;
      background-color: #fcfcfe;
    }

    &__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: spx(240) spx(40) spx(120);
      @include tablet-up {
        min-height: ppx(800 * 1.2);
        padding: ppx(400 * 1.2) ppx(40 * 1.2) ppx(120 * 1.2);
      }
      @include desktop-up {
        min-height: ppx(800);
        padding: ppx(400) ppx(40) ppx(120);
      }
    }

    // 見出し（サンバースト＋STAY＋サブ見出し）
    &__title {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(10);
      @include tablet-up {
        gap: ppx(25 * 1.2);
      }
      @include desktop-up {
        gap: ppx(25);
      }
    }

    &__sunburst {
      display: block;
      width: spx(263);
      height: auto;
      @include tablet-up {
        width: ppx(263 * 1.2);
      }
      @include desktop-up {
        width: ppx(263);
      }
    }

    &__title-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(50 * 1.2);
      }
      @include desktop-up {
        gap: ppx(50);
      }
    }

    &__title-heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(5);
      @include tablet-up {
        gap: ppx(10 * 1.2);
      }
      @include desktop-up {
        gap: ppx(10);
      }
    }

    &__title-en {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.1;
      white-space: nowrap;
      font-size: spx(79);
      letter-spacing: spx(3.95);
      @include tablet-up {
        font-size: ppx(105 * 1.2);
        letter-spacing: ppx(5.25 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(105);
        letter-spacing: ppx(5.25);
      }
    }

    &__title-ja {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.7;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(32 * 1.2);
        letter-spacing: ppx(1.6 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    // SPだけ「から」のあとで折る
    &__lead-br {
      @include tablet-up {
        display: none;
      }
    }

    &__lead {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.6;
      font-size: spx(40);
      letter-spacing: spx(2);
      // FigmaはPCだけ行送りが150%
      @include tablet-up {
        line-height: 1.5;
        font-size: ppx(55 * 1.2);
        letter-spacing: ppx(2.75 * 1.2);
      }
      @include desktop-up {
        line-height: 1.5;
        font-size: ppx(55);
        letter-spacing: ppx(2.75);
      }
    }

    // カードグリッド（SP=2列 / PC=4列）
    &__grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      // SP: カード2列(334×2+8=676) が inner の左右padding(40×2)の内側より広いため
      // 幅を固定してはみ出しつつ中央配置（Figmaの左右余白22px相当）
      width: spx(676);
      // Figmaは見出しブロックとの間が30px
      margin-top: spx(30);
      gap: spx(50) spx(8);
      @include tablet-up {
        width: 100%;
        margin-top: ppx(100 * 1.2);
        gap: ppx(70 * 1.2) ppx(25 * 1.2);
      }
      @include desktop-up {
        margin-top: ppx(100);
        gap: ppx(130) ppx(25);
      }
    }

    // カード
    &__card {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: spx(334);
      max-width: 100%;
      @include tablet-up {
        width: ppx(530 * 1.2);
      }
      @include desktop-up {
        width: ppx(530);
      }
    }

    &__card-photo {
      position: relative;
      width: 100%;
      aspect-ratio: 334 / 303;
      @include tablet-up {
        aspect-ratio: 530 / 480;
      }
    }

    &__card-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: spx(20) spx(20) 0 0;
      @include tablet-up {
        border-radius: ppx(30 * 1.2) ppx(30 * 1.2) 0 0;
      }
      @include desktop-up {
        border-radius: ppx(30) ppx(30) 0 0;
      }
    }

    // バッジ（花形フレーム＋テキスト）
    &__card-badge {
      position: absolute;
      top: spx(8);
      left: spx(10);
      width: spx(131);
      @include tablet-up {
        top: ppx(22 * 1.2);
        left: ppx(20 * 1.2);
        width: ppx(164 * 1.2);
      }
      @include desktop-up {
        top: ppx(22);
        left: ppx(20);
        width: ppx(164);
      }
    }

    &__card-badge-frame {
      display: block;
      width: 100%;
      height: auto;
    }

    &__card-badge-text {
      // フレーム上部の「\Check//」装飾を避けて中央やや下に配置
      position: absolute;
      top: 56%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.1;
      color: #507425;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      text-align: center;
      white-space: nowrap;
    }

    &__card-badge-top {
      font-size: spx(17);
      letter-spacing: spx(0.85);
      @include tablet-up {
        font-size: ppx(22 * 1.2);
        letter-spacing: ppx(1.1 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(22);
        letter-spacing: ppx(1.1);
      }
    }

    &__card-badge-bottom {
      font-size: spx(30);
      @include tablet-up {
        font-size: ppx(38 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(38);
      }
    }

    // サイトコード（円形バッジ）: カード中央・写真下端にまたがる配置
    &__card-code {
      position: absolute;
      left: 50%;
      bottom: spx(-19);
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      width: spx(76);
      height: spx(76);
      border-radius: 50%;
      background-color: #8aad61;
      color: #fff;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      line-height: 1.1;
      font-size: spx(26);
      z-index: 2;
      @include tablet-up {
        bottom: ppx(-30 * 1.2);
        width: ppx(120 * 1.2);
        height: ppx(120 * 1.2);
        font-size: ppx(40 * 1.2);
      }
      @include desktop-up {
        bottom: ppx(-30);
        width: ppx(120);
        height: ppx(120);
        font-size: ppx(40);
      }
    }

    // カード下部（白ボックス）
    &__card-body {
      display: flex;
      flex-direction: column;
      background-color: #fff;
      border-radius: 0 0 spx(20) spx(20);
      padding: spx(32) 0;
      gap: spx(20);
      @include tablet-up {
        border-radius: 0 0 ppx(30 * 1.2) ppx(30 * 1.2);
        padding: ppx(50 * 1.2) 0;
        gap: ppx(36 * 1.2);
      }
      @include desktop-up {
        border-radius: 0 0 ppx(30) ppx(30);
        padding: ppx(50) 0;
        gap: ppx(36);
      }
    }

    &__card-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(16);
      @include tablet-up {
        gap: ppx(25 * 1.2);
      }
      @include desktop-up {
        gap: ppx(25);
      }
    }

    &__card-title {
      margin: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.4;
      font-size: spx(27);
      letter-spacing: spx(2.7);
      @include tablet-up {
        font-size: ppx(38 * 1.2);
        letter-spacing: ppx(3.8 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(38);
        letter-spacing: ppx(3.8);
      }
    }

    &__card-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: spx(4);
      width: spx(300);
      // PC/TBは max-width 90% だとコンテナが477pxになり、
      // 3個（156×3＋gap6×2＝480px）が1行に収まらないので外す
      max-width: 90%;
      @include tablet-up {
        max-width: none;
        gap: ppx(6 * 1.2);
        width: ppx(480 * 1.2);
      }
      @include desktop-up {
        gap: ppx(6);
        width: ppx(480);
      }
    }

    &__card-tag {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: spx(146);
      padding: spx(5) spx(10) spx(7);
      border-radius: spx(7);
      background-color: #dde9cd;
      color: #507425;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      text-align: center;
      white-space: nowrap;
      font-size: spx(21);
      @include tablet-up {
        min-width: ppx(156 * 1.2);
        padding: ppx(8 * 1.2) ppx(10 * 1.2) ppx(10 * 1.2);
        border-radius: ppx(10 * 1.2);
        font-size: ppx(22 * 1.2);
      }
      @include desktop-up {
        min-width: ppx(156);
        padding: ppx(8) ppx(10) ppx(10);
        border-radius: ppx(10);
        font-size: ppx(22);
      }
    }

    // 料金＋矢印
    &__card-price {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: spx(25);
      padding-right: spx(19);
      @include tablet-up {
        gap: ppx(40 * 1.2);
        padding-right: ppx(30 * 1.2);
      }
      @include desktop-up {
        gap: ppx(40);
        padding-right: ppx(30);
      }
    }

    &__card-price-text {
      margin: 0;
      color: #507425;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      letter-spacing: spx(0.95);
      white-space: nowrap;
      @include tablet-up {
        letter-spacing: ppx(1.5 * 1.2);
      }
      @include desktop-up {
        letter-spacing: ppx(1.5);
      }
    }

    &__card-price-amount {
      line-height: 1.2;
      font-size: spx(30);
      @include tablet-up {
        font-size: ppx(41 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(41);
      }
    }

    &__card-price-unit {
      line-height: 1.2;
      font-size: spx(22);
      @include tablet-up {
        font-size: ppx(26 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(26);
      }
    }

    &__card-arrow {
      display: block;
      width: spx(32);
      height: auto;
      @include tablet-up {
        width: ppx(50 * 1.2);
      }
      @include desktop-up {
        width: ppx(50);
      }
    }

    // MORE ボタン
    &__more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: spx(10);
      margin-top: spx(90);
      background-color: #8aad61;
      border: spx(4) solid #fff;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      padding: spx(35) spx(110);
      @include tablet-up {
        margin-top: ppx(90 * 1.2);
        gap: ppx(10 * 1.2);
        border-width: ppx(4 * 1.2);
        box-shadow: 0 ppx(10 * 1.2) ppx(12 * 1.2) rgba(0, 0, 0, 0.08);
        padding: ppx(35 * 1.2) ppx(110 * 1.2);
      }
      @include desktop-up {
        margin-top: ppx(100);
        gap: ppx(10);
        border-width: ppx(4);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
        padding: ppx(35) ppx(110);
      }

      @include hover {
        &:hover {
          opacity: 0.85;
        }
      }
    }

    &__more-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      @include tablet-up {
        font-size: ppx(26 * 1.2);
        letter-spacing: ppx(1.3 * 1.2);
      }
      @include desktop-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    &__more-arrow {
      display: block;
      width: spx(28);
      height: auto;
      @include tablet-up {
        width: ppx(28 * 1.2);
      }
      @include desktop-up {
        width: ppx(28);
      }
    }

    // 最下部の大きな写真（全幅・SP/PCで出し分け）
    // 画像は上部が空に向かって透過するアルファグラデーション付き。
    // 透過部分をコンテンツ側へ重ね（負のmargin）、不透明な山〜湖〜キャンプ場のみを見せる
    &__bottom {
      position: relative;
      z-index: 0;
      width: 100%;
      // 重なり量はデザインカンプ基準: 山の稜線が MORE ボタンの直下（約20px）に来る位置
      margin-top: -320vw; // SP画像（1123x4096、稜線は上端から約307vw）
      line-height: 0;
      font-size: 0;
      pointer-events: none;
      @include tablet-up {
        margin-top: -145vw; // PC画像（1600x3394）: 稜線が MORE ボタン直下に来る位置

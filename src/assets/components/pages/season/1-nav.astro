---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import { seasons } from "../../../../data/seasons";
---

<nav class="season-nav" aria-label="季節">
  <!-- 背景の紙テクスチャ -->
  <div
    class="season-nav__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <ul class="season-nav__list">
    {
      seasons.map((season) => (
        <li>
          <a class="season-nav__item" href={`#${season.key}`}>
            <span class="season-nav__ja">{season.ja}</span>
            <span class="season-nav__en">{season.en}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .season-nav {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #bee0e1;
    padding-top: spx(50);
    padding-bottom: spx(20);
    @include tablet-up {
      padding-top: ppx(80);
      padding-bottom: ppx(20);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // SPは2列に折り返す
    &__list {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: center;
      width: spx(598);
      gap: spx(18);
      @include tablet-up {
        width: auto;
        gap: ppx(20);
      }
    }

    &__item {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      border-style: solid;
      border-color: #000;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      white-space: nowrap;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
      width: spx(290);
      padding: spx(33) 0;
      border-width: spx(3.691);
      gap: spx(14);
      line-height: spx(22.142);
      @include tablet-up {
        width: ppx(314);
        padding: ppx(35) ppx(90);
        border-width: ppx(4);
        gap: ppx(15);
        line-height: ppx(26);
      }

      // ホバー: 黒背景＋白文字にディゾルブ（指示書）
      @include hover {
        &:hover {
          background-color: #000;
          color: #fff;
        }
      }
    }

    &__ja {
      font-size: spx(30.45);
      letter-spacing: spx(1.5225);
      @include tablet-up {
        font-size: ppx(36);
        letter-spacing: ppx(1.8);
      }
    }

    &__en {
      font-size: spx(23.07);
      letter-spacing: spx(1.1535);
      @include tablet-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }
  }
</style>

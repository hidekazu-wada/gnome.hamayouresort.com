---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import PaperTexturePlain from "../../../images/common/paper-texture-plain.png";

// 繋ぎの波（ユーザー支給SVG）。形は共通で色だけ違う。秋は春と同色のため使い回し
import toSpringPc from "../../../images/season/wave-to-spring.svg";
import toSpringSp from "../../../images/season/wave-to-spring-sp.svg";
import toSummerPc from "../../../images/season/wave-to-summer.svg";
import toSummerSp from "../../../images/season/wave-to-summer-sp.svg";
import toWinterPc from "../../../images/season/wave-to-winter.svg";
import toWinterSp from "../../../images/season/wave-to-winter-sp.svg";
import toFooterPc from "../../../images/season/wave-to-footer.svg";
import toFooterSp from "../../../images/season/wave-to-footer-sp.svg";

interface Props {
  /** どのセクションへの繋ぎか */
  to: "spring" | "summer" | "autumn" | "winter" | "footer";
}

const { to } = Astro.props;

const waves = {
  spring: { pc: toSpringPc, sp: toSpringSp },
  summer: { pc: toSummerPc, sp: toSummerSp },
  autumn: { pc: toSpringPc, sp: toSpringSp },
  winter: { pc: toWinterPc, sp: toWinterSp },
  footer: { pc: toFooterPc, sp: toFooterSp },
};

// 枠の背景＝下のセクションの地（Figmaの繋ぎフレームと同じ）。冬だけ色なしの素テクスチャ
const bgColors: Record<string, string | null> = {
  spring: "#fff7fa",
  summer: "#bee0e1",
  autumn: "#e2dbc1",
  winter: null,
  footer: "#bee0e1",
};

const bgColor = bgColors[to];
const texture = bgColor ? PaperTexture : PaperTexturePlain;

// Figmaでは波の矩形にもテクスチャがluminosity合成で上掛けされている。
// SVG書き出しでは再現されないため、波の形でマスクしたテクスチャをCSSで重ねる。
// フッター繋ぎだけは波の塗り自体がテクスチャ画像なので不要
const needsWaveTexture = to !== "footer";
---

<div
  class:list={["season-wave", { "is-plain": !bgColor }]}
  style={bgColor ? `background-color: ${bgColor};` : undefined}
>
  <div
    class="season-wave__texture"
    aria-hidden="true"
    style={`background-image: url(${texture.src});`}
  >
  </div>
  <picture class="season-wave__picture">
    <source srcset={waves[to].pc.src} media="(min-width: 744px)" />
    <img class="season-wave__img" src={waves[to].sp.src} alt="" />
  </picture>
  {
    needsWaveTexture && (
      <div
        class="season-wave__wave-texture"
        aria-hidden="true"
        style={`background-image: url(${PaperTexture.src}); --mask-pc: url(${waves[to].pc.src}); --mask-sp: url(${waves[to].sp.src});`}
      />
    )
  }
</div>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // SVGは波の上端が枠より上にはみ出した状態で書き出されている
  .season-wave {
    position: relative;
    height: spx(66);
    @include tablet-up {
      height: ppx(207.816);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 色を敷かない節（冬）は合成モードを掛けない
    &.is-plain &__texture {
      mix-blend-mode: normal;
    }

    &__picture {
      position: absolute;
      display: block;
      z-index: 1;
      left: 0;
      width: 100%;
      top: spx(-11.7);
      @include tablet-up {
        top: ppx(-11.54);
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }

    // 波の形でマスクしたテクスチャ（Figmaの波矩形のIMAGE:LUMINOSITY塗りを再現）
    &__wave-texture {
      position: absolute;
      z-index: 2;
      left: 0;
      width: 100%;
      pointer-events: none;
      background-repeat: repeat;
      background-position: top left;
      mix-blend-mode: luminosity;
      mask-image: var(--mask-sp);
      mask-size: 100% auto;
      mask-repeat: no-repeat;
      -webkit-mask-image: var(--mask-sp);
      -webkit-mask-size: 100% auto;
      -webkit-mask-repeat: no-repeat;
      top: spx(-11.7);
      aspect-ratio: 720 / 79;
      background-size: spx(140);
      @include tablet-up {
        mask-image: var(--mask-pc);
        -webkit-mask-image: var(--mask-pc);
        top: ppx(-11.54);
        aspect-ratio: 2560 / 212;
        background-size: ppx(200);
      }
    }
  }
</style>

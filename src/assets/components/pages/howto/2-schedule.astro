---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import type { Howto } from "../../../../data/howto";

interface Props {
  howto: Howto;
}

const { howto } = Astro.props;

// 時間軸は日をまたいで1列に並べる
const items = howto.schedule.flatMap((day) => day.items);
---

<section class="howto-schedule">
  <!-- 背景の紙テクスチャ -->
  <div
    class="howto-schedule__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  {/* SPはDay見出しごと横スクロールさせる（Figmaは1700幅のストリップ） */}
  <div class="howto-schedule__scroll">
    <div class="howto-schedule__inner">
      <div class="howto-schedule__head">
        <div class="howto-schedule__days">
          {howto.schedule.map((day) => <p>{day.day}</p>)}
        </div>
        <div class="howto-schedule__line" aria-hidden="true"></div>
      </div>

      <ul class="howto-schedule__list">
        {
          items.map((item) => (
            <li class="howto-schedule__item">
              <p class="howto-schedule__time">{item.time}</p>
              <p class="howto-schedule__label">{item.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .howto-schedule {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #e2dbc1;
    padding-top: spx(40);
    padding-bottom: spx(60);
    @include tablet-up {
      padding-top: ppx(150);
      padding-bottom: 0;
    }

    // SPはDay見出し・線・項目をまとめて横スクロール
    &__scroll {
      position: relative;
      z-index: 1;
      width: 100%;
      overflow-x: auto;
      @include tablet-up {
        width: auto;
        overflow-x: visible;
      }
    }

    &__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: spx(1700);
      gap: spx(47);
      @include tablet-up {
        align-items: center;
        width: auto;
        gap: ppx(47);
      }
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 区切り線の太さ(2px)をgapから引く
    &__head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: spx(25);
      @include tablet-up {
        align-items: center;
        gap: ppx(25);
      }
    }

    &__days {
      box-sizing: border-box;
      display: flex;
      align-items: flex-start;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      white-space: nowrap;
      line-height: 1.8;
      // 白フチ（Figmaはstroke 5のOUTSIDE）
      -webkit-text-stroke: spx(10) #fff;
      paint-order: stroke fill;
      padding-left: spx(100);
      gap: spx(808);
      font-size: spx(47);
      letter-spacing: spx(2.35);
      @include tablet-up {
        -webkit-text-stroke-width: ppx(10);
        width: ppx(2120);
        padding-left: ppx(74);
        gap: ppx(1143);
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
      }
    }

    // Figmaは実線
    &__line {
      background-color: #000;
      height: spx(2);
      width: spx(1500);
      margin-left: spx(100);
      @include tablet-up {
        width: ppx(2120);
        height: ppx(2);
        margin-left: 0;
      }
    }

    &__list {
      display: flex;
      align-items: flex-start;
      padding-left: spx(100);
      gap: spx(40);
      @include tablet-up {
        padding-left: 0;
        gap: ppx(90);
      }
    }

    &__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      text-align: center;
      width: spx(94);
      gap: spx(11);
      @include tablet-up {
        width: ppx(94);
        gap: ppx(11);
      }
    }

    &__time {
      width: 100%;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #c3925e;
      line-height: 1.8;
      font-size: spx(35);
      @include tablet-up {
        font-size: ppx(35);
      }
    }

    // 縦組み。1文字幅の箱に折り返させる作りにすると、禁則処理で「チェ」「ック」が
    // 分かれずに横に並んでしまう（Firefox・Edge）ので、本物の縦書きで組む。
    // 長音符が縦向きになり、SUP のような欧文も1文字ずつ縦に積める。
    // 字間はFigmaの行送り36px（font-size 30 × 1.2）に合わせて letter-spacing で作る。
    &__label {
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1;
      font-size: spx(30);
      // 縦書きの字送りは「文字幅＋letter-spacing」なので、行送り36pxぶんを letter-spacing で作る。
      // letter-spacing は文字の後ろにしか入らず全体が上にずれるため、
      // 折り返しで組んでいたとき（行ボックスの中央に文字が乗る）と同じ位置になるよう
      // 半分を先頭に足し、そのぶん末尾を詰めて高さを元のままにする
      letter-spacing: spx(6);
      padding-top: spx(3);
      margin-bottom: spx(-3);
      @include tablet-up {
        font-size: ppx(30);
        letter-spacing: ppx(6);
        padding-top: ppx(3);
        margin-bottom: ppx(-3);
      }
    }
  }
</style>

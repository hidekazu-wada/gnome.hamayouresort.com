---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

// この節は色を敷かず、テクスチャ画像そのものを背景にする（Figma同様）
import PaperTexture from "../../../images/common/paper-texture-plain.png";
import IconClock from "../../../images/howto/icon-clock.svg";
import type { Howto } from "../../../../data/howto";

interface Props {
  day: Howto["days"][number];
}

const { day } = Astro.props;
---

<section class="howto-day">
  <!-- 背景の紙テクスチャ -->
  <div
    class="howto-day__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <div class="howto-day__head">
    <h2 class="howto-day__title">{day.day}</h2>
    <div class="howto-day__title-line" aria-hidden="true"></div>
  </div>

  {
    day.entries.map((entry) => (
      <div class="howto-day__entry">
        <div class="howto-day__photo">
          <img
            class="howto-day__photo-img"
            src={entry.photo.src}
            width={entry.photo.width}
            height={entry.photo.height}
            alt=""
            loading="lazy"
          />
        </div>

        <div class="howto-day__text">
          <p class="howto-day__time">
            <img class="howto-day__time-icon" src={IconClock.src} alt="" />
            <span>{entry.time}</span>
          </p>
          <p class="howto-day__entry-title">{entry.title}</p>
          <p class="howto-day__body">{entry.body}</p>
        </div>
      </div>
    ))
  }
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .howto-day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: spx(60);
    padding-bottom: spx(15);
    gap: spx(40);
    @include tablet-up {
      padding-top: ppx(120);
      padding-bottom: ppx(15);
      gap: ppx(40);
    }

    // 色を敷かずテクスチャそのものを見せるため、合成モードは掛けない
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 線が高さ0で描かれる分、gapから5pxを引く
    &__head {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(25);
      @include tablet-up {
        gap: ppx(25);
      }
    }

    &__title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #7c6351;
      text-align: center;
      line-height: 1.8;
      font-size: spx(56);
      letter-spacing: spx(2.8);
      margin-right: spx(-2.8);
      @include tablet-up {
        font-size: ppx(80);
        letter-spacing: ppx(4);
        margin-right: ppx(-4);
      }
    }

    &__title-line {
      width: spx(630);
      height: spx(5);
      background-repeat: repeat-x;
      background-image: repeating-linear-gradient(
        to right,
        #7c6351 0,
        #7c6351 #{spx(9)},
        transparent #{spx(9)},
        transparent #{spx(16)}
      );
      @include tablet-up {
        width: ppx(1800);
        height: ppx(5);
        background-image: repeating-linear-gradient(
          to right,
          #7c6351 0,
          #7c6351 #{ppx(11)},
          transparent #{ppx(11)},
          transparent #{ppx(21)}
        );
      }
    }

    &__entry {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: spx(10) 0 spx(40);
      gap: spx(40);
      @include tablet-up {
        flex-direction: row;
        align-items: center;
        padding: ppx(50) 0;
        gap: ppx(110);
      }
    }

    &__photo {
      overflow: clip;
      flex-shrink: 0;
      line-height: 0;
      width: spx(630);
      border-radius: spx(30);
      @include tablet-up {
        width: ppx(976);
        border-radius: ppx(50);
      }
    }

    &__photo-img {
      display: block;
      width: 100%;
      object-fit: cover;
      height: spx(473);
      @include tablet-up {
        height: ppx(732);
      }
    }

    &__text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: spx(20);
      @include tablet-up {
        height: ppx(558);
        gap: ppx(30);
      }
    }

    &__time {
      display: flex;
      align-items: center;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #7c6351;
      line-height: 1.6;
      white-space: nowrap;
      gap: spx(20);
      font-size: spx(40);
      letter-spacing: spx(4);
      @include tablet-up {
        gap: ppx(20);
        font-size: ppx(40);
        letter-spacing: ppx(4);
      }
    }

    &__time-icon {
      display: block;
      width: spx(55);
      height: spx(55);
      @include tablet-up {
        width: ppx(55);
        height: ppx(55);
      }
    }

    &__entry-title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #c3925e;
      line-height: 1.6;
      font-size: spx(43);
      letter-spacing: spx(4.3);
      margin-right: spx(-4.3);
      @include tablet-up {
        font-size: ppx(65);
        letter-spacing: ppx(6.5);
        margin-right: ppx(-6.5);
      }
    }

    &__body {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.8;
      width: spx(630);
      font-size: spx(27);
      @include tablet-up {
        width: ppx(715);
        font-size: ppx(30);
      }
    }
  }
</style>

---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import WavePc from "../../../images/stay/detail/wave-to-related.webp";
import WaveSp from "../../../images/stay/detail/wave-to-related-sp.webp";
import IconArrow from "../../../images/common/icon-arrow-white.svg";
import ActivityCard from "../../common/activityCard/ActivityCard.astro";
import { activities } from "../../../../data/activities";
---

<!-- 予約方法 → おすすめのアクティビティ の繋ぎ -->
<div class="stay-related-wave">
  <div
    class="stay-related-wave__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>
  <picture class="stay-related-wave__picture">
    <source srcset={WavePc.src} media="(min-width: 744px)" />
    <img class="stay-related-wave__img" src={WaveSp.src} alt="" />
  </picture>
</div>

<section class="stay-related">
  <!-- 背景の紙テクスチャ -->
  <div
    class="stay-related__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <h2 class="stay-related__title">
    <span class="stay-related__title-em">おすすめ</span>のアクティビティ
  </h2>

  <div class="stay-related__slider swiper">
    <ul class="swiper-wrapper">
      {
        activities.map((item) => (
          <li class="stay-related__slide swiper-slide">
            <ActivityCard activity={item} variant="green" />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="stay-related__pagination"></div>

  <a class="stay-related__button" href="/activity/">
    <span class="stay-related__button-label">アクティビティ一覧</span>
    <img class="stay-related__button-icon" src={IconArrow.src} alt="" />
  </a>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  const el = document.querySelector<HTMLElement>(".stay-related__slider");
  if (el) {
    const swiper = new Swiper(el, {
      modules: [Autoplay, Pagination],
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: false },
      // SPはカード幅530のスライドを中央に置き、前後を左右にチラ見せ（Figma準拠）
      slidesPerView: "auto",
      spaceBetween: 0,
      centeredSlides: true,
      pagination: {
        el: ".stay-related__pagination",
        clickable: true,
      },
      breakpoints: {
        744: { slidesPerView: "auto", spaceBetween: 0, centeredSlides: false },
      },
    });
    // フォント・画像読み込み後に幅を再計測（vw幅の初期計測ずれ対策）
    window.addEventListener("load", () => swiper.update());
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 枠の背景は下のセクション（おすすめのアクティビティ）と同じ色＋テクスチャ。
  // 波は左右にも少しはみ出すので、設計どおりの幅と位置で置く
  .stay-related-wave {
    position: relative;
    z-index: 1;
    background-color: #bee0e1;
    // 波は左右に意図的にはみ出しているので、そのぶんが body の横幅を広げないよう切る。
    // 上方向（top: spx(-11.536)）へのはみ出しは残したいので overflow-x だけにする
    overflow-x: clip;
    height: spx(96);
    @include tablet-up {
      height: ppx(200);
    }

    // z-index を付けて合成の基準をこの枠内に閉じる（無いと body の背景と混ざる）
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__picture {
      position: absolute;
      display: block;
      top: spx(-11.536);
      left: spx(-13.896);
      width: spx(745.366);
      @include tablet-up {
        top: ppx(-11.54);
        left: ppx(-11.008);
        width: ppx(2582.547);
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .stay-related {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #bee0e1;
    padding-bottom: spx(90);
    @include tablet-up {
      padding-bottom: ppx(80);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__title {
      position: relative;
      z-index: 1;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.8;
      padding-top: spx(80);
      font-size: spx(46);
      letter-spacing: spx(2.3);
      margin-right: spx(-2.3);
      @include tablet-up {
        padding-top: ppx(100);
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
        margin-right: ppx(-2.35);
      }
    }

    &__title-em {
      color: #507425;
    }

    // PCは設計どおり4枚（530×4＋間隔10×3）が収まる幅に絞って中央寄せ
    &__slider {
      position: relative;
      z-index: 1;
      width: 100%;
      padding-top: spx(40);
      @include tablet-up {
        width: ppx(2150);
        margin: ppx(10) auto 0;
        padding-top: ppx(60);
      }
    }

    &__slide {
      display: flex;
      justify-content: center;
      height: auto;
      width: spx(530);
      @include tablet-up {
        width: ppx(530);
        margin-right: ppx(10);
      }
    }

    &__pagination {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: spx(80);
      gap: spx(20);
      @include tablet-up {
        padding-top: ppx(110);
        gap: ppx(20);
      }

      :global(.swiper-pagination-bullet) {
        opacity: 1;
        background-color: #fff;
        margin: 0 !important;
        width: spx(25);
        height: spx(25);
        @include tablet-up {
          width: ppx(30);
          height: ppx(30);
        }
      }

      :global(.swiper-pagination-bullet-active) {
        background-color: #d6b156;
      }
    }

    &__button {
      position: relative;
      z-index: 1;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      transition: background-color 0.3s ease;
      width: spx(496);
      margin-top: spx(60);
      padding: spx(31) 0;
      border-width: spx(4);
      gap: spx(10);
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        // トップページと同じボタン仕様（496×96）
        width: ppx(496);
        margin-top: ppx(110);
        padding: ppx(31) 0;
        border-width: ppx(4);
        gap: ppx(10);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      // ホバー: #d6b156にディゾルブ（指示書）
      @include hover {
        &:hover {
          background-color: #d6b156;
        }
      }
    }

    &__button-icon {
      display: block;
      width: spx(28);
      height: spx(28);
      @include tablet-up {
        width: ppx(28);
        height: ppx(28);
      }
    }
  }
</style>

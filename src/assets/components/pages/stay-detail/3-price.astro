---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import WavePc from "../../../images/stay/detail/wave-to-price.webp";
import WaveSp from "../../../images/stay/detail/wave-to-price-sp.webp";
// ホテルセットプランバナーの装飾（ボタンのホバーを効かせるためHTML＋分割素材で構成）
import HotelPlanHotel from "../../../images/stay/detail/hotel-plan-hotel.svg";
import HotelPlanRain from "../../../images/stay/detail/hotel-plan-rain.svg";
import HotelPlanTeruteru from "../../../images/stay/detail/hotel-plan-teruteru.svg";
import HotelPlanCircles from "../../../images/stay/detail/hotel-plan-circles.svg";
import HotelPlanArrow from "../../../images/stay/detail/hotel-plan-arrow.svg";
import type { Stay } from "../../../../data/stays";

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;

const HOTEL_PLAN_URL = "/hotel-set-plan/";
---

<!-- エリアマップ → 料金 の繋ぎ -->
<div class="stay-price-wave">
  <div
    class="stay-price-wave__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>
  <picture class="stay-price-wave__picture">
    <source srcset={WavePc.src} media="(min-width: 744px)" />
    <img class="stay-price-wave__img" src={WaveSp.src} alt="" />
  </picture>
</div>

<section class="stay-price" id="price">
  <h2 class="stay-price__title">料金</h2>

  <dl class="stay-price__table">
    {
      stay.priceRows.map((row, i) => (
        <div class="stay-price__row">
          <dt class="stay-price__label">
            <span class="stay-price__label-text" set:html={row.label} />
          </dt>
          <dd class="stay-price__value">
            <div
              class:list={[
                "stay-price__value-body",
                { "is-inline-pc": row.linesInlinePc },
              ]}
            >
              {i === 0 ? (
                <p class="stay-price__amount">{stay.priceAmount}</p>
              ) : (
                <>
                  {row.lines?.map((line) => (
                    <p class="stay-price__line">{line}</p>
                  ))}
                  {row.notes && (
                    <div
                      class:list={[
                        "stay-price__notes",
                        { "is-tight": row.notesTightGap },
                      ]}
                    >
                      {row.notes.map((note) => (
                        <p>{note}</p>
                      ))}
                    </div>
                  )}
                </>
              )}
            </div>
          </dd>
        </div>
      ))
    }
  </dl>

  <a
    class="stay-price__banner"
    href={HOTEL_PLAN_URL}
    aria-label="雨の日でも安心 HOTEL SET PLAN（ホテルセットプラン）の詳細はこちら"
  >
    <!-- 白丸の帯＋キャッチコピー -->
    <span class="stay-price__banner-catch">
      <img
        class="stay-price__banner-catch-circles"
        src={HotelPlanCircles.src}
        alt=""
      />
      {/* 白丸は7つの等分なので、文字も7等分のセルに入れて確実に中心へ乗せる */}
      <span class="stay-price__banner-catch-text">
        {
          [..."雨の日でも安心"].map((ch) => (
            <span class="stay-price__banner-catch-char">{ch}</span>
          ))
        }
      </span>
    </span>

    <span class="stay-price__banner-texts">
      <span class="stay-price__banner-en">HOTEL SET PLAN</span>
      <span class="stay-price__banner-ja">ホテルセットプラン</span>
    </span>

    <span class="stay-price__banner-btn">
      <span class="stay-price__banner-btn-text">詳細はこちら</span>
      <img
        class="stay-price__banner-btn-icon"
        src={HotelPlanArrow.src}
        alt=""
      />
    </span>

    <!-- 装飾イラスト -->
    <img
      class="stay-price__banner-hotel"
      src={HotelPlanHotel.src}
      alt=""
    />
    <img class="stay-price__banner-rain" src={HotelPlanRain.src} alt="" />
    <img
      class="stay-price__banner-teruteru"
      src={HotelPlanTeruteru.src}
      alt=""
    />
  </a>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 繋ぎ。枠の背景は上のセクション（エリアマップ）と同じ色＋テクスチャ
  .stay-price-wave {
    position: relative;
    background-color: #fffdf7;
    height: spx(59.0625);
    @include tablet-up {
      height: ppx(210);
    }

    // z-index を付けて合成の基準をこの枠内に閉じる
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 波は枠より上（エリアマップ側）にはみ出すので、枠に合わせて上へずらす
    &__picture {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      top: spx(-3.0845);
      @include tablet-up {
        top: ppx(-10.966);
      }
    }

    // 波の絵はかすれたブラシで描かれていて、下端の1行だけ塗りが薄い。
    // 枠の境目とその行が重なると、下地が透けて細い明るい線に見える。
    // ここは薄い行が画像の下端側にあるので、1px下へずらして料金セクションの
    // ベタ塗りに被せて隠す（上へずらすと逆に線が濃くなる）
    &__img {
      position: relative;
      top: 1px;
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .stay-price {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #138185;
    padding-top: spx(30);
    padding-bottom: spx(195);
    gap: spx(40);
    @include tablet-up {
      // Figmaはタイトルがセクション先頭にぴったり・バナー下に231
      padding-top: 0;
      padding-bottom: ppx(231);
      gap: ppx(40);
    }

    &__title {
      width: 100%;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fffdf7;
      text-align: center;
      line-height: 1.5;
      font-size: spx(46);
      letter-spacing: spx(2.3);
      @include tablet-up {
        line-height: 1.8;
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
      }
    }

    &__table {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(10);
      }
    }

    // SPはラベルが上、PCはラベルが左
    &__row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      @include tablet-up {
        flex-direction: row;
      }
    }

    &__label {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #bee0e1;
      padding: spx(30);
      border-radius: spx(20) spx(20) 0 0;
      @include tablet-up {
        padding: ppx(30);
        border-radius: ppx(20) 0 0 ppx(20);
      }
    }

    // アーリー／レイトの改行はPC・TB用。SPはラベル欄が広いので1行に収める。
    // set:html で流し込むためスコープ属性が付かず :global で当てる
    :global(.stay-price__br-pc) {
      display: none;
      @include tablet-up {
        display: inline;
      }
    }

    &__label-text {
      display: block;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #138185;
      text-align: center;
      line-height: 1.6;
      width: spx(570);
      font-size: spx(32);
      letter-spacing: spx(1.6);
      @include tablet-up {
        width: ppx(240);
        text-align: left;
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__value {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #fff;
      padding: spx(30);
      border-radius: 0 0 spx(20) spx(20);
      @include tablet-up {
        padding: ppx(30);
        border-radius: 0 ppx(20) ppx(20) 0;
      }
    }

    &__value-body {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.7; // FigmaのSP本文は行送り170%
      width: spx(570);
      font-size: spx(27);
      letter-spacing: 0; // FigmaのSP本文は字間なし（PCのみ5%）
      @include tablet-up {
        line-height: 1.6;
        width: ppx(1440);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    // キャンセル料行: SPは3行積み・PCは1行に並べる（間隔は全角スペース相当）
    &__value-body.is-inline-pc :global(.stay-price__line) {
      @include tablet-up {
        display: inline-block;
        margin-right: ppx(32);

        &:last-child {
          margin-right: 0;
        }
      }
    }

    &__amount {
      font-weight: 700;
      color: #c3925e;
      font-size: spx(42);
      letter-spacing: 0;
      @include tablet-up {
        font-size: ppx(50);
        letter-spacing: ppx(2.5);
      }
    }

    // 注記は1行分あけて小さく（SPは24px基準の41、PCは本文32px基準の51）
    &__notes {
      margin-top: spx(41);
      font-size: spx(24);
      @include tablet-up {
        margin-top: ppx(51);
        font-size: ppx(26);
      }

      // Figmaで空行が注記26px基準（アーリーチェックイン行）
      &.is-tight {
        @include tablet-up {
          margin-top: ppx(42);
        }
      }
    }

    // ホテルセットプランのバナー（装飾はSVG・テキストとボタンはHTML）
    &__banner {
      position: relative;
      display: block;
      background-color: #bee0e1;
      width: spx(630);
      height: spx(343);
      border-radius: spx(10.5);
      @include tablet-up {
        width: ppx(1800);
        height: ppx(323);
        border-radius: ppx(30);
        margin-top: ppx(50); // Figmaは表→バナーが90（gap40＋50）
      }
    }

    // 白丸の帯＋キャッチコピー
    &__banner-catch {
      position: absolute;
      display: block;
      left: spx(154.4);
      top: spx(86.3);
      width: spx(320.2);
      height: spx(43.1);
      @include tablet-up {
        left: ppx(640);
        top: ppx(33);
        width: ppx(520);
        height: ppx(70);
      }
    }

    &__banner-catch-circles {
      display: block;
      width: 100%;
      height: 100%;
    }

    // letter-spacing で字間を作ると、文字送りと丸の間隔のわずかな差が後ろの文字ほど
    // 積み上がってズレる（PCで最大9.4px）ので、1文字ずつ丸の中心に置く
    &__banner-catch-text {
      position: absolute;
      inset: 0;
      display: block;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      line-height: 1;
      white-space: nowrap;
      font-size: spx(28.9);
      @include tablet-up {
        font-size: ppx(47);
      }
    }

    // 丸は7等分ではない（hotel-plan-circles.svg は viewBox 520×70 で
    // cx = 35 + 75i、半径35）。等分で置くと最大 ±0.41%＝PC2560で2.14px ずれるので、
    // SVGの実座標をそのまま％にして中心に乗せる
    &__banner-catch-char {
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);

      @for $i from 0 through 6 {
        &:nth-child(#{$i + 1}) {
          left: percentage((35 + 75 * $i) / 520);
        }
      }
    }

    &__banner-texts {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      white-space: nowrap;
      top: spx(132.4);
      gap: spx(6.2);
      @include tablet-up {
        top: ppx(108);
        gap: ppx(10);
      }
    }

    &__banner-en {
      display: block;
      line-height: 1.1;
      font-size: spx(64.65);
      letter-spacing: spx(3.23);
      margin-right: spx(-3.23);
      @include tablet-up {
        font-size: ppx(105);
        letter-spacing: ppx(5.25);
        margin-right: ppx(-5.25);
      }
    }

    &__banner-ja {
      display: block;
      line-height: 1.7;
      font-size: spx(19.7);
      letter-spacing: spx(0.99);
      margin-right: spx(-0.99);
      @include tablet-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
        margin-right: ppx(-1.6);
      }
    }

    // 詳細はこちらボタン。バナー全体が1リンクなので、ホバーはバナー側で受ける
    &__banner-btn {
      position: absolute;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      transition: background-color 0.3s ease;
      left: spx(390);
      top: spx(290.5);
      transform: translateY(-50%);
      width: spx(220);
      height: spx(67);
      border-width: spx(2.8);
      gap: spx(7);
      box-shadow: 0 spx(7) spx(8.4) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        left: ppx(1423);
        top: ppx(232);
        width: auto;
        height: auto;
        padding: ppx(35) ppx(60);
        border-width: ppx(4);
        gap: ppx(10);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }
    }

    // ホバー: ボタンがゴールドにディゾルブ（指示書 #d6b156）
    @include hover {
      &__banner:hover &__banner-btn {
        background-color: #d6b156;
      }
    }

    &__banner-btn-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      white-space: nowrap;
      font-size: spx(18.1);
      letter-spacing: spx(0.9);
      @include tablet-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
      }
    }

    &__banner-btn-icon {
      display: block;
      width: spx(17.4);
      height: spx(17.4);
      @include tablet-up {
        width: ppx(25);
        height: ppx(25);
      }
    }

    // 装飾イラスト
    &__banner-hotel {
      position: absolute;
      display: block;
      left: spx(10);
      bottom: 0;
      width: spx(207.6);
      height: auto;
      @include tablet-up {
        left: 0;
        bottom: ppx(33);
        width: ppx(366);
      }
    }

    &__banner-rain {
      position: absolute;
      display: block;
      top: 0;
      right: spx(17.6);
      width: spx(171.2);
      height: auto;
      @include tablet-up {
        right: ppx(50);
        width: ppx(330);
      }
    }

    &__banner-teruteru {
      position: absolute;
      display: block;
      left: spx(491.2);
      top: spx(77);
      width: spx(65.3);
      height: auto;
      @include tablet-up {
        left: ppx(1187);
        top: ppx(18);
        width: ppx(106);
      }
    }
  }
</style>

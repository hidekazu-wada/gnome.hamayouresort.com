---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import WavePc from "../../../images/stay/detail/wave-to-price.webp";
import WaveSp from "../../../images/stay/detail/wave-to-price-sp.webp";
import HotelPlan from "../../../images/stay/detail/hotel-set-plan.webp";
import HotelPlanSp from "../../../images/stay/detail/hotel-set-plan-sp.webp";
import type { Stay } from "../../../../data/stays";

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;

const HOTEL_PLAN_URL = "/hotel-set-plan/";
---

<!-- エリアマップ → 料金 の繋ぎ -->
<div class="stay-price-wave">
  <div
    class="stay-price-wave__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>
  <picture class="stay-price-wave__picture">
    <source srcset={WavePc.src} media="(min-width: 744px)" />
    <img class="stay-price-wave__img" src={WaveSp.src} alt="" />
  </picture>
</div>

<section class="stay-price" id="price">
  <h2 class="stay-price__title">料金</h2>

  <dl class="stay-price__table">
    {
      stay.priceRows.map((row, i) => (
        <div class="stay-price__row">
          <dt class="stay-price__label">
            <span class="stay-price__label-text" set:html={row.label} />
          </dt>
          <dd class="stay-price__value">
            <div class="stay-price__value-body">
              {i === 0 ? (
                <p class="stay-price__amount">{stay.priceAmount}</p>
              ) : (
                <>
                  {row.lines?.map((line) => (
                    <p class="stay-price__line">{line}</p>
                  ))}
                  {row.notes && (
                    <div
                      class:list={[
                        "stay-price__notes",
                        { "is-tight": row.notesTightGap },
                      ]}
                    >
                      {row.notes.map((note) => (
                        <p>{note}</p>
                      ))}
                    </div>
                  )}
                </>
              )}
            </div>
          </dd>
        </div>
      ))
    }
  </dl>

  <a
    class="stay-price__banner"
    href={HOTEL_PLAN_URL}
    aria-label="雨の日でも安心 HOTEL SET PLAN（ホテルセットプラン）の詳細はこちら"
  >
    <picture>
      <source srcset={HotelPlan.src} media="(min-width: 744px)" />
      <img class="stay-price__banner-img" src={HotelPlanSp.src} alt="" />
    </picture>
  </a>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 繋ぎ。枠の背景は上のセクション（エリアマップ）と同じ色＋テクスチャ
  .stay-price-wave {
    position: relative;
    background-color: #fffdf7;
    height: spx(59.0625);
    @include tablet-up {
      height: ppx(210);
    }

    // z-index を付けて合成の基準をこの枠内に閉じる
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 波は枠より上（エリアマップ側）にはみ出すので、枠に合わせて上へずらす
    &__picture {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      top: spx(-3.0845);
      @include tablet-up {
        top: ppx(-10.966);
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .stay-price {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #138185;
    padding-top: spx(30);
    padding-bottom: spx(195);
    gap: spx(40);
    @include tablet-up {
      // Figmaはタイトルがセクション先頭にぴったり・バナー下に231
      padding-top: 0;
      padding-bottom: ppx(231);
      gap: ppx(40);
    }

    &__title {
      width: 100%;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fffdf7;
      text-align: center;
      line-height: 1.5;
      font-size: spx(46);
      letter-spacing: spx(2.3);
      @include tablet-up {
        line-height: 1.8;
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
      }
    }

    &__table {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(10);
      }
    }

    // SPはラベルが上、PCはラベルが左
    &__row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      @include tablet-up {
        flex-direction: row;
      }
    }

    &__label {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #bee0e1;
      padding: spx(30);
      border-radius: spx(20) spx(20) 0 0;
      @include tablet-up {
        padding: ppx(30);
        border-radius: ppx(20) 0 0 ppx(20);
      }
    }

    &__label-text {
      display: block;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #138185;
      text-align: center;
      line-height: 1.6;
      width: spx(570);
      font-size: spx(32);
      letter-spacing: spx(1.6);
      @include tablet-up {
        width: ppx(240);
        text-align: left;
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__value {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #fff;
      padding: spx(30);
      border-radius: 0 0 spx(20) spx(20);
      @include tablet-up {
        padding: ppx(30);
        border-radius: 0 ppx(20) ppx(20) 0;
      }
    }

    &__value-body {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.7; // FigmaのSP本文は行送り170%
      width: spx(570);
      font-size: spx(27);
      letter-spacing: 0; // FigmaのSP本文は字間なし（PCのみ5%）
      @include tablet-up {
        line-height: 1.6;
        width: ppx(1440);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__amount {
      font-weight: 700;
      color: #c3925e;
      font-size: spx(42);
      letter-spacing: 0;
      @include tablet-up {
        font-size: ppx(50);
        letter-spacing: ppx(2.5);
      }
    }

    // 注記は1行分あけて小さく（SPは24px基準の41、PCは本文32px基準の51）
    &__notes {
      margin-top: spx(41);
      font-size: spx(24);
      @include tablet-up {
        margin-top: ppx(51);
        font-size: ppx(26);
      }

      // Figmaで空行が注記26px基準（アーリーチェックイン行）
      &.is-tight {
        @include tablet-up {
          margin-top: ppx(42);
        }
      }
    }

    // ホテルセットプランのバナー
    &__banner {
      display: block;
      transition: opacity 0.3s ease;
      width: spx(630);
      @include tablet-up {
        width: ppx(1800);
        margin-top: ppx(50); // Figmaは表→バナーが90（gap40＋50）
      }

      @include hover {
        &:hover {
          opacity: 0.85;
        }
      }
    }

    &__banner-img {
      display: block;
      width: 100%;
      height: auto;
    }
  }
</style>

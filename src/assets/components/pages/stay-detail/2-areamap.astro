---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import WavePc from "../../../images/stay/detail/wave-to-areamap.webp";
import WaveSp from "../../../images/stay/detail/wave-to-areamap-sp.webp";
import AreaMap from "../../../images/stay/detail/area-map.jpg";
import Deco from "../../../images/stay/detail/area-map-deco.svg";
import type { Stay } from "../../../../data/stays";

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;

// マップ画像（設計1868×1401）に対する赤枠の位置を％で置く
const marker = {
  left: `${(stay.mapMarker.left / 1868) * 100}%`,
  top: `${(stay.mapMarker.top / 1401) * 100}%`,
  width: `${(stay.mapMarker.width / 1868) * 100}%`,
  height: `${(stay.mapMarker.height / 1401) * 100}%`,
};
---

<!-- 概要 → エリアマップ の繋ぎ -->
<div class="stay-areamap-wave">
  <div
    class="stay-areamap-wave__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>
  <picture class="stay-areamap-wave__picture">
    <source srcset={WavePc.src} media="(min-width: 744px)" />
    <img class="stay-areamap-wave__img" src={WaveSp.src} alt="" />
  </picture>
</div>

<section class="stay-areamap" id="areamap">
  <!-- 背景の紙テクスチャ -->
  <div
    class="stay-areamap__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <!-- 左上のテント・木のイラスト -->
  <img class="stay-areamap__deco" src={Deco.src} alt="" />

  <div class="stay-areamap__head">
    <h2 class="stay-areamap__title">AREA MAP</h2>
    <p class="stay-areamap__title-ja">エリアマップ</p>
  </div>

  <div class="stay-areamap__map">
    <img class="stay-areamap__map-img" src={AreaMap.src} alt="場内エリアマップ" />
    <span
      class="stay-areamap__marker"
      aria-hidden="true"
      style={`left:${marker.left};top:${marker.top};width:${marker.width};height:${marker.height};`}
    ></span>
  </div>
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 繋ぎ。枠の背景は下のセクションと同じ色＋テクスチャ
  .stay-areamap-wave {
    position: relative;
    background-color: #fffdf7;
    height: spx(66);
    @include tablet-up {
      height: ppx(188);
    }

    // z-index を付けて合成の基準をこの枠内に閉じる
    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__picture {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      top: spx(-11.7);
      @include tablet-up {
        top: ppx(-11.54);
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .stay-areamap {
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #fffdf7;
    // SPは左上の飾りイラスト(高さ208)を避けてタイトルが230から始まる
    padding-top: spx(230);
    padding-bottom: spx(60);
    gap: spx(20);
    @include tablet-up {
      padding-top: ppx(150);
      padding-bottom: ppx(60);
      gap: ppx(20);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__deco {
      position: absolute;
      z-index: 1;
      display: block;
      top: spx(20);
      left: 0;
      width: spx(382);
      height: auto;
      @include tablet-up {
        top: ppx(-14);
        width: ppx(812);
      }
    }

    &__head {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      color: #7c6351;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      text-align: center;
      line-height: 1;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(30);
      }
    }

    &__title {
      font-size: spx(88);
      letter-spacing: spx(4.4);
      margin-right: spx(-4.4);
      @include tablet-up {
        font-size: ppx(118);
        letter-spacing: ppx(5.9);
        margin-right: ppx(-5.9);
      }
    }

    &__title-ja {
      font-size: spx(24);
      letter-spacing: spx(1.2);
      margin-right: spx(-1.2);
      @include tablet-up {
        font-size: ppx(26);
        letter-spacing: ppx(1.3);
        margin-right: ppx(-1.3);
      }
    }

    // z-index を付けるとスタッキングコンテキストができて
    // 中の multiply が背景と合成されなくなるので付けない
    &__map {
      position: relative;
      line-height: 0;
      width: spx(700);
      @include tablet-up {
        width: ppx(1868);
      }
    }

    &__map-img {
      display: block;
      width: 100%;
      height: auto;
      mix-blend-mode: multiply;
    }

    // 現在のサイト位置
    &__marker {
      position: absolute;
      display: block;
      border-style: solid;
      border-color: #ef6f6f;
      border-width: spx(6);
      border-radius: spx(11);
      @include tablet-up {
        border-width: ppx(12);
        border-radius: ppx(21.7);
      }
    }
  }
</style>

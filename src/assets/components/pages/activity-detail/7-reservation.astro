---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
// 繋ぎの透過部分は注意事項と同じ「色を敷かないテクスチャ」が透けて見える想定
import PaperTexturePlain from "../../../images/common/paper-texture-plain.png";
import WavePc from "../../../images/activity/detail/wave-to-reservation.webp";
import WaveSp from "../../../images/activity/detail/wave-to-reservation-sp.webp";

interface Props {
  /**
   * アクティビティ個別の予約先。省略するとノーム共通（TEL＋なっぷ）になる。
   * 主催が外部のアクティビティ（Hobie / カヤック）はここで上書きする。
   */
  reservation?: {
    url: string;
    label?: string;
    note?: string;
    operatorNote?: string;
  };
}

const { reservation } = Astro.props;

// 予約先はサイト共通（URL確定後に差し替え）
const TEL = "0555-82-2650";
const WEB_RESERVE_URL = "https://www.nap-camp.com/yamanashi/13592";

const webUrl = reservation?.url ?? WEB_RESERVE_URL;
const webLabel = reservation?.label ?? "WEB予約はこちら";
const webNote = reservation?.note ?? "（ 受付時間 24時間 ）";

// 遷移先が外部サイトのときだけ別タブで開く。
// せのうみツアーは自サイトの /contact/ に飛ばすので同じタブのまま
const isExternal = webUrl.startsWith("http");
---

<!-- 注意事項 → 予約方法 の繋ぎ -->
<div
  class="detail-reservation-wave"
  style={`background-image: url(${PaperTexturePlain.src});`}
>
  <picture class="detail-reservation-wave__picture">
    <source srcset={WavePc.src} media="(min-width: 744px)" />
    <img class="detail-reservation-wave__img" src={WaveSp.src} alt="" />
  </picture>
</div>

<section class="detail-reservation" id="reservation">
  <!-- 背景の紙テクスチャ -->
  <div
    class="detail-reservation__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <div class="detail-reservation__head">
    <h2 class="detail-reservation__title">予約方法</h2>
    <div class="detail-reservation__title-line" aria-hidden="true"></div>
  </div>

  <div class="detail-reservation__cards">
    <a class="detail-reservation__card" href={`tel:${TEL}`}>
      <span class="detail-reservation__card-main">
        <span class="detail-reservation__card-tel-label">TEL.&nbsp;</span>{TEL}
      </span>
      <span class="detail-reservation__card-note">（ 受付時間 9:00~17:00 ）</span>
    </a>
    <a
      class="detail-reservation__card"
      href={webUrl}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
    >
      <span class="detail-reservation__card-main detail-reservation__card-main--web">
        {webLabel}
      </span>
      <span class="detail-reservation__card-note">{webNote}</span>
    </a>
  </div>

  {
    reservation?.operatorNote && (
      <p class="detail-reservation__operator">{reservation.operatorNote}</p>
    )
  }
</section>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 背景は透過。透けた部分は注意事項と同じテクスチャを敷いて繋ぐ。
  // SPは画像が枠より上に広いので、枠に合わせて上へずらす
  .detail-reservation-wave {
    position: relative;
    z-index: 1;
    background-repeat: repeat;
    background-position: top left;
    background-size: spx(140);
    height: spx(89.5);
    @include tablet-up {
      height: ppx(289);
      background-size: ppx(200);
    }

    &__picture {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      top: spx(-54.98);
      @include tablet-up {
        top: 0;
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .detail-reservation {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #c0d4a9;
    padding-top: spx(80);
    padding-bottom: spx(60);
    gap: spx(50);
    @include tablet-up {
      padding-top: ppx(150);
      padding-bottom: ppx(35);
      gap: ppx(100);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 線が高さ0で描かれる分、gapから5pxを引く
    &__head {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: spx(25);
      @include tablet-up {
        gap: ppx(25);
      }
    }

    &__title {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #7c6351;
      text-align: center;
      line-height: 1.5;
      font-size: spx(46);
      letter-spacing: spx(2.3);
      margin-right: spx(-2.3);
      @include tablet-up {
        line-height: 1.8;
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
        margin-right: ppx(-2.35);
      }
    }

    &__title-line {
      width: spx(630);
      height: spx(5);
      background-repeat: repeat-x;
      background-image: repeating-linear-gradient(
        to right,
        #7c6351 0,
        #7c6351 #{spx(9)},
        transparent #{spx(9)},
        transparent #{spx(16)}
      );
      @include tablet-up {
        width: ppx(1800);
        height: ppx(5);
        background-image: repeating-linear-gradient(
          to right,
          #7c6351 0,
          #7c6351 #{ppx(11)},
          transparent #{ppx(11)},
          transparent #{ppx(21)}
        );
      }
    }

    &__cards {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: spx(20);
      @include tablet-up {
        flex-direction: row;
        align-items: stretch;
        gap: ppx(40);
      }
    }

    &__card {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: #fffdf7;
      color: #7c6351;
      text-align: center;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
      width: spx(600);
      padding: spx(8) spx(60) spx(16);
      border-radius: spx(16);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        width: auto;
        height: ppx(176);
        padding: ppx(10) ppx(75) ppx(20);
        border-radius: ppx(20);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      // ホバー: 茶背景＋クリーム文字にディゾルブ（指示書 #7c6351）
      @include hover {
        &:hover {
          background-color: #7c6351;
          color: #fffdf7;
        }
      }
    }

    &__card-main {
      display: block;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      line-height: 1.4;
      white-space: nowrap;
      font-size: spx(51);
      letter-spacing: spx(2.05);
      @include tablet-up {
        font-size: ppx(64);
        letter-spacing: ppx(2.05);
      }
    }

    // 設計ではテキスト幅567（＋左右パディング75でカード幅717）
    &__card-main--web {
      font-size: spx(33);
      @include tablet-up {
        width: ppx(567);
        font-size: ppx(41);
      }
    }

    &__card-tel-label {
      font-size: spx(33);
      @include tablet-up {
        font-size: ppx(41);
      }
    }

    // 主催が外部のアクティビティに出す注記
    &__operator {
      position: relative;
      z-index: 1;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #7c6351;
      text-align: center;
      line-height: 1.8;
      width: spx(600);
      font-size: spx(24);
      letter-spacing: spx(1.2);
      margin-right: spx(-1.2);
      @include tablet-up {
        width: ppx(1600);
        font-size: ppx(28);
        letter-spacing: ppx(1.4);
        margin-right: ppx(-1.4);
      }
    }

    &__card-note {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      line-height: 1.6;
      white-space: nowrap;
      font-size: spx(26);
      letter-spacing: spx(2.05);
      @include tablet-up {
        font-size: ppx(33);
        letter-spacing: ppx(2.05);
      }
    }
  }
</style>

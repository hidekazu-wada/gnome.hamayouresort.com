---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import Wave from "../../../images/activity/detail/wave-to-related.webp";
import IconArrow from "../../../images/common/icon-arrow-white.svg";
import ActivityCard from "../../common/activityCard/ActivityCard.astro";
import { activities, type Activity } from "../../../../data/activities";

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;

// 表示中のアクティビティを除いた一覧（実データ確定後は「人気順」に差し替える）
const related = activities.filter((item) => item.slug !== activity.slug);
---

<!-- 予約方法 → 人気のアクティビティ の繋ぎ -->
<div class="detail-related-wave">
  <img class="detail-related-wave__img" src={Wave.src} alt="" />
</div>

<section class="detail-related">
  <!-- 背景の紙テクスチャ -->
  <div
    class="detail-related__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <h2 class="detail-related__title">
    <span class="detail-related__title-em">人気</span>のアクティビティ
  </h2>

  <div class="detail-related__slider swiper">
    <ul class="swiper-wrapper">
      {
        related.map((item) => (
          <li class="detail-related__slide swiper-slide">
            <ActivityCard activity={item} variant="green" />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="detail-related__pagination"></div>

  <a class="detail-related__button" href="/activity/">
    <span class="detail-related__button-label">アクティビティ一覧</span>
    <img class="detail-related__button-icon" src={IconArrow.src} alt="" />
  </a>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  const el = document.querySelector<HTMLElement>(".detail-related__slider");
  if (el) {
    const swiper = new Swiper(el, {
      modules: [Autoplay, Pagination],
      // 指示書「←矢印の方向にスライド（自動再生）」
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: false },
      slidesPerView: 1.15,
      spaceBetween: 12,
      centeredSlides: true,
      pagination: {
        el: ".detail-related__pagination",
        clickable: true,
      },
      breakpoints: {
        744: { slidesPerView: "auto", spaceBetween: 0, centeredSlides: false },
      },
    });
    // フォント・画像読み込み後に幅を再計測（vw幅の初期計測ずれ対策）
    window.addEventListener("load", () => swiper.update());
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .detail-related-wave {
    display: block;
    line-height: 0;
    font-size: 0;

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .detail-related {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #bee0e1;
    padding-bottom: spx(80);
    @include tablet-up {
      padding-bottom: ppx(100);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__title {
      position: relative;
      z-index: 1;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.8;
      padding-top: spx(80);
      font-size: spx(46);
      letter-spacing: spx(2.3);
      margin-right: spx(-2.3);
      @include tablet-up {
        padding-top: ppx(100);
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
        margin-right: ppx(-2.35);
      }
    }

    &__title-em {
      color: #507425;
    }

    // PCは設計どおり4枚（530×4＋間隔10×3）が収まる幅に絞って中央寄せ
    &__slider {
      position: relative;
      z-index: 1;
      width: 100%;
      padding-top: spx(40);
      @include tablet-up {
        width: ppx(2150);
        margin: 0 auto;
        padding-top: ppx(60);
      }
    }

    // PCは設計値どおりカード幅530＋間隔10で並べる
    &__slide {
      display: flex;
      justify-content: center;
      height: auto;
      @include tablet-up {
        width: ppx(530);
        margin-right: ppx(10);
      }
    }

    &__pagination {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: spx(40);
      gap: spx(20);
      @include tablet-up {
        padding-top: ppx(100);
        gap: ppx(20);
      }

      :global(.swiper-pagination-bullet) {
        opacity: 1;
        background-color: #cfcfcf;
        margin: 0 !important;
        width: spx(25);
        height: spx(25);
        @include tablet-up {
          width: ppx(30);
          height: ppx(30);
        }
      }

      :global(.swiper-pagination-bullet-active) {
        background-color: #7f7f7f;
      }
    }

    &__button {
      position: relative;
      z-index: 1;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      transition: opacity 0.3s ease;
      margin-top: spx(60);
      padding: spx(35) spx(80);
      border-width: spx(4);
      gap: spx(10);
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        margin-top: ppx(110);
        padding: ppx(35) ppx(110);
        border-width: ppx(4);
        gap: ppx(10);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      @include hover {
        &:hover {
          opacity: 0.8;
        }
      }
    }

    &__button-icon {
      display: block;
      width: spx(28);
      height: spx(28);
      @include tablet-up {
        width: ppx(28);
        height: ppx(28);
      }
    }
  }
</style>

---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";
// 地図の描画に必要。JS本体は遅延ロードするが、CSSは軽いので先に読ませる
import "leaflet/dist/leaflet.css";
import "leaflet.markercluster/dist/MarkerCluster.css";

import PaperTexture from "../../../images/common/paper-texture.png";
import AreaCard from "./AreaCard.astro";
import { categories, groups, origin, pois, farCount } from "../../../../data/areaPois";

// 「楽しむ」を先に出す（滞在の予定を決める人が多数で、困りごとは後から探されるため）
const groupOrder = ["enjoy", "essentials"] as const;
const groupedCategories = groupOrder.map((id) => {
  const group = groups.find((g) => g.id === id)!;
  return {
    ...group,
    items: group.categories.map((c) => categories.find((x) => x.id === c)!).filter(Boolean),
  };
});
---

<section
  class="area-map"
  data-origin-lat={origin.lat}
  data-origin-lng={origin.lng}
  data-origin-name="キャンプビレッジノーム"
  style={`--area-paper: url(${PaperTexture.src});`}
>
  <!-- 背景の紙テクスチャ。SPで貼り付けるパネルにも同じものを敷くので変数で持つ -->
  <div class="area-map__texture" aria-hidden="true"></div>

  <div class="area-map__inner">
    <!-- 「近くに何でもある」と見せかけないための一文。ここを隠すと現地で失望が起きる -->
    <!-- 改行以外の空白が入らないよう set:html で流す（PCでは br が消えて1行になる） -->
    <p
      class="area-map__notice"
      set:html={'西湖のまわりにコンビニ・スーパーはありません。<br class="area-map__br-sp">最寄りのコンビニで車11分、スーパーは13分。<br class="area-map__br-sp">買い出しは到着前に済ませておくと快適です。'}
    />


    <div class="area-map__body">
      <!--
        SPでは地図とチップをひとまとめにして画面上部に貼り付ける。
        カードをタップしたときに、いちいち地図までスクロールして戻らずに済むようにするため。
        PCでは __panel を display:contents にして、中身をそのままグリッドに並べ直す。
      -->
      <div class="area-map__panel">
        <div class="area-map__map-col">
          <div class="area-map__frame">
            <div class="area-map__canvas" data-map-canvas>
              <!-- 地図はここに後から乗る。JSが動かない環境ではリスト側だけで完結する -->
              <p class="area-map__fallback">
                地図を読み込んでいます。表示されない場合は下の一覧をご覧ください。
              </p>
            </div>
          </div>
        </div>

        <div class="area-map__filters">
          {
            groupedCategories.map((group) => (
              <div class="area-map__filter-group">
                <p class="area-map__filter-label">{group.label}</p>
                <ul class="area-map__chips">
                  {group.items.map((category) => (
                    <li>
                      <button
                        class="area-map__chip"
                        type="button"
                        data-cat={category.id}
                        aria-pressed="true"
                      >
                        <span
                          class="area-map__chip-dot"
                          aria-hidden="true"
                          style={`background-color: ${category.color};`}
                        />
                        {category.label}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 使用頻度が低いので、貼り付ける領域には入れず流れるままにする -->
      <div class="area-map__filter-actions">
        <button class="area-map__text-button" type="button" data-select-all>
          すべて選択
        </button>
        <button class="area-map__text-button" type="button" data-clear-all>
          すべて解除
        </button>
      </div>

      <div class="area-map__list-col">
        <p class="area-map__count">
          <span data-visible-count>{pois.filter((p) => p.tier !== 3 || p.alwaysVisible).length}</span
          >件を表示中
        </p>

        <ul class="area-map__list" data-poi-list>
          {
            pois.map((poi) => (
              <li class="area-map__list-item">
                <AreaCard poi={poi} />
              </li>
            ))
          }
        </ul>

        <p class="area-map__empty" data-empty hidden>
          条件に合う場所がありません。
          <button class="area-map__text-button" type="button" data-select-all>
            フィルタをリセット
          </button>
        </p>

        <button class="area-map__more" type="button" data-show-far>
          車で20分より遠いところも見る（{farCount}件）
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".area-map");

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>(".area-card"));
    const items = Array.from(section.querySelectorAll<HTMLElement>(".area-map__list-item"));
    const chips = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-cat]"));
    const canvas = section.querySelector<HTMLElement>("[data-map-canvas]");
    const moreButton = section.querySelector<HTMLButtonElement>("[data-show-far]");
    const emptyEl = section.querySelector<HTMLElement>("[data-empty]");
    const countEl = section.querySelector<HTMLElement>("[data-visible-count]");

    // 地図＋チップのパネルは画面上部に貼り付くので、カードへスクロールするときは
    // その高さぶん手前で止めないと、カードがパネルの裏に入って見えなくなる。
    // PCではパネルが display: contents で箱を持たない（高さ0）ため自動的に無効になる
    const panel = section.querySelector<HTMLElement>(".area-map__panel");
    const syncPanelHeight = () => {
      const h = panel?.getBoundingClientRect().height ?? 0;
      section.style.setProperty("--area-panel-h", `${Math.round(h)}px`);
    };
    syncPanelHeight();
    window.addEventListener("resize", syncPanelHeight);
    // チップの折り返しや dvh の変化（アドレスバーの伸縮）にも追従させる
    if (panel && "ResizeObserver" in window) {
      new ResizeObserver(syncPanelHeight).observe(panel);
    }

    const origin = {
      lat: Number(section.dataset.originLat),
      lng: Number(section.dataset.originLng),
      name: section.dataset.originName ?? "",
    };

    const allCategories = chips.map((chip) => chip.dataset.cat!);
    let selected = new Set(allCategories);
    let showFar = false;

    // --- URLクエリから状態を復元 -------------------------------------------
    // 滞在中の人が家族にURLを送るので、絞り込みが共有とリロードで保てること
    const params = new URLSearchParams(location.search);
    const catParam = params.get("cat");
    if (catParam) {
      const restored = catParam.split(",").filter((c) => allCategories.includes(c));
      if (restored.length > 0) selected = new Set(restored);
    }
    if (params.get("far") === "1") showFar = true;

    const isVisible = (card: HTMLElement) => {
      const cats = (card.dataset.categories ?? "").split(" ");
      if (!cats.some((c) => selected.has(c))) return false;
      // 買い出し先と救急は全部20分超なので、距離で隠すと「1軒もない」ように見えてしまう
      if (card.dataset.alwaysVisible === "true") return true;
      return showFar || card.dataset.tier !== "3";
    };

    const syncUrl = () => {
      const next = new URLSearchParams(location.search);
      if (selected.size === allCategories.length) next.delete("cat");
      else next.set("cat", allCategories.filter((c) => selected.has(c)).join(","));
      if (showFar) next.set("far", "1");
      else next.delete("far");
      const query = next.toString();
      history.replaceState(null, "", query ? `?${query}${location.hash}` : location.pathname + location.hash);
    };

    // 地図側から差し込まれる更新関数。地図が未ロードのうちは何もしない
    let onFilterChange: (() => void) | null = null;

    const apply = () => {
      let visible = 0;
      items.forEach((item, index) => {
        const show = isVisible(cards[index]);
        item.hidden = !show;
        if (show) visible += 1;
      });

      chips.forEach((chip) => {
        const on = selected.has(chip.dataset.cat!);
        chip.setAttribute("aria-pressed", String(on));
        chip.classList.toggle("is-on", on);
      });

      if (countEl) countEl.textContent = String(visible);
      if (emptyEl) emptyEl.hidden = visible > 0;

      // tier3 が1件も該当しないなら「もっと見る」自体を出さない
      if (moreButton) {
        const hiddenFar = cards.filter(
          (card) =>
            card.dataset.tier === "3" &&
            card.dataset.alwaysVisible !== "true" &&
            (card.dataset.categories ?? "").split(" ").some((c) => selected.has(c))
        ).length;
        moreButton.hidden = showFar || hiddenFar === 0;
        moreButton.textContent = `車で20分より遠いところも見る（${hiddenFar}件）`;
      }

      syncUrl();
      onFilterChange?.();
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const id = chip.dataset.cat!;
        if (selected.has(id)) selected.delete(id);
        else selected.add(id);
        apply();
      });
    });

    section.querySelectorAll<HTMLButtonElement>("[data-select-all]").forEach((button) => {
      button.addEventListener("click", () => {
        selected = new Set(allCategories);
        apply();
      });
    });

    section.querySelectorAll<HTMLButtonElement>("[data-clear-all]").forEach((button) => {
      button.addEventListener("click", () => {
        selected = new Set();
        apply();
      });
    });

    moreButton?.addEventListener("click", () => {
      showFar = true;
      apply();
    });

    apply();

    // --- 地図（progressive enhancement）-------------------------------------
    // リストだけで情報は完結しているので、地図は見えるところまで来てから読み込む
    if (canvas) {
      const loadMap = async () => {
        const L = (await import("leaflet")).default;
        await import("leaflet.markercluster");

        canvas.textContent = "";

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const map = L.map(canvas, {
          center: [origin.lat, origin.lng],
          zoom: 12,
          scrollWheelZoom: false, // ページを縦スクロール中に地図に持っていかれないように
        });

        // 国土地理院の淡色地図。キー不要・商用可（出典表示が条件）
        L.tileLayer("https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png", {
          attribution:
            '<a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank" rel="noopener">国土地理院</a>',
          maxZoom: 18,
        }).addTo(map);

        /** Figmaのピンと同じ形。カテゴリ色だけ差し替える */
        const pinSvg = (color: string, scale = 1) => {
          const w = Math.round(34 * scale);
          const h = Math.round(41 * scale);
          return `<svg width="${w}" height="${h}" viewBox="0 0 59 71" xmlns="http://www.w3.org/2000/svg"><path d="M56.5 29.5C56.5 50.5 29.5 68.5 29.5 68.5C29.5 68.5 2.5 50.5 2.5 29.5C2.5 22.3392 5.34463 15.4716 10.4081 10.4081C15.4716 5.34463 22.3392 2.5 29.5 2.5C36.6608 2.5 43.5284 5.34463 48.5919 10.4081C53.6554 15.4716 56.5 22.3392 56.5 29.5Z" fill="${color}" stroke="black" stroke-width="5" stroke-linejoin="round"/><path d="M29.5 38.5C34.47 38.5 38.5 34.47 38.5 29.5C38.5 24.53 34.47 20.5 29.5 20.5C24.53 20.5 20.5 24.53 20.5 29.5C20.5 34.47 24.53 38.5 29.5 38.5Z" fill="white" stroke="black" stroke-width="5" stroke-linejoin="round"/></svg>`;
        };

        // 選択中はカードとの対応が一目で分かる必要があるので、
        // 拡大だけでなく足元に輪を敷いて影を落とし、名前も出す（ラベルは setActive 側で付ける）
        const makeIcon = (color: string, mode: "normal" | "hover" | "active") => {
          const scale = mode === "active" ? 1.6 : mode === "hover" ? 1.25 : 1;
          const w = Math.round(34 * scale);
          const h = Math.round(41 * scale);
          const ring = mode === "active" ? '<span class="area-pin__ring"></span>' : "";
          return L.divIcon({
            className: `area-pin area-pin--${mode}`,
            html: `${ring}${pinSvg(color, scale)}`,
            iconSize: [w, h],
            iconAnchor: [Math.round(w / 2), h],
            // 既定だとラベルが足元（＝ピンの上）に出て絵に被るので、頭の上を基準にする
            tooltipAnchor: [0, -h],
          });
        };

        // 起点。カテゴリで消えない・他のどれとも違う見た目・ラベル常時表示。
        // 押しても何も起きないので、ボタンとして読み上げさせない（ラベルは常時見えている）
        L.marker([origin.lat, origin.lng], {
          zIndexOffset: 1000,
          interactive: false,
          keyboard: false,
          icon: L.divIcon({
            className: "area-origin",
            html: `<span class="area-origin__dot"></span>`,
            iconSize: [30, 30],
            iconAnchor: [15, 15],
          }),
        })
          .addTo(map)
          .bindTooltip(origin.name, {
            permanent: true,
            direction: "top",
            offset: [0, -14],
            className: "area-origin__label",
          });

        const cluster = (L as any).markerClusterGroup({
          // すぐ団子になると探せないので、重なっている点だけまとめる程度に緩めておく
          maxClusterRadius: 45,
          disableClusteringAtZoom: 15,
          showCoverageOnHover: false,
          spiderfyOnMaxZoom: true,
          iconCreateFunction: (c: any) =>
            L.divIcon({
              className: "area-cluster",
              html: `<span>${c.getChildCount()}</span><span class="area-sr-only">件のスポット</span>`,
              iconSize: [46, 46],
            }),
        });
        map.addLayer(cluster);

        let activeId: string | null = null;

        const entries = cards.map((card, index) => {
          const color = card.dataset.color ?? "#138185";
          const label = `${card.dataset.name}, 車で${card.dataset.minutes}分`;
          const marker = L.marker([Number(card.dataset.lat), Number(card.dataset.lng)], {
            icon: makeIcon(color, "normal"),
            keyboard: true,
            title: card.dataset.name,
          });
          // divIcon には alt が付かないので、DOMに乗るたびに読み上げ用のラベルを当て直す
          // （クラスタリングで要素が作り直されるため on("add") で毎回セットする）
          marker.on("add", () => marker.getElement()?.setAttribute("aria-label", label));
          return {
            card,
            item: items[index],
            marker,
            color,
            id: card.dataset.poiId!,
            name: card.dataset.name ?? "",
          };
        });

        const setActive = (id: string | null, { scroll = false } = {}) => {
          activeId = id;
          entries.forEach((entry) => {
            const on = entry.id === id;
            entry.card.classList.toggle("is-active", on);
            entry.marker.setIcon(makeIcon(entry.color, on ? "active" : "normal"));
            entry.marker.setZIndexOffset(on ? 800 : 0);
            // 選択中だけ名前を出す。どのピンがカードに対応するのかを言葉で示す
            entry.marker.unbindTooltip();
            if (on) {
              entry.marker.bindTooltip(entry.name, {
                permanent: true,
                direction: "top",
                offset: [0, -4],
                className: "area-pin__label",
              });
            }
          });
          if (!scroll || !id) return;
          const target = entries.find((entry) => entry.id === id);
          // 直前に測り直す。パネルの高さはチップの折り返しやアドレスバーで変わるので、
          // 読み込み時の値のままだと止まる位置がずれる
          syncPanelHeight();
          // scroll-margin-top は li 側に持たせてあるので、カード本体ではなく li を寄せる
          // （カードを対象にすると余白が効かず、貼り付いた地図の裏で止まる）
          const scrollTarget =
            target?.card.closest<HTMLElement>(".area-map__list-item") ?? target?.card;
          scrollTarget?.scrollIntoView({ block: "nearest", behavior: reduceMotion ? "auto" : "smooth" });
        };

        entries.forEach((entry) => {
          // マーカーをクリックしたらカードへ寄せる。ポップアップは出さず情報はカードに一本化する
          entry.marker.on("click", () => setActive(entry.id, { scroll: true }));

          const focus = () => {
            if (activeId === entry.id) return;
            entry.marker.setIcon(makeIcon(entry.color, "hover"));
            entry.marker.setZIndexOffset(400);
          };
          const blur = () => {
            if (activeId === entry.id) return;
            entry.marker.setIcon(makeIcon(entry.color, "normal"));
            entry.marker.setZIndexOffset(0);
          };
          entry.card.addEventListener("mouseenter", focus);
          entry.card.addEventListener("mouseleave", blur);
          entry.card.addEventListener("focus", focus);
          entry.card.addEventListener("blur", blur);

          // カードをクリック/Enterで、地図をそのマーカーへ寄せる。
          // クラスタリングは zoom 15 で解除されるので、そこまで寄せないと
          // 選んだピンが束に畳まれたままで「どれなのか」が分からない
          const fly = () => {
            setActive(entry.id);
            const zoom = Math.max(map.getZoom(), 15);
            const latlng = entry.marker.getLatLng();
            if (reduceMotion) map.setView(latlng, zoom);
            else map.flyTo(latlng, zoom, { duration: 0.6 });
          };
          entry.card.addEventListener("click", (event) => {
            // カード内のリンク（ルート・電話・公式サイト）を潰さない
            if ((event.target as HTMLElement).closest("a")) return;
            fly();
          });
          entry.card.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") return;
            if ((event.target as HTMLElement).closest("a")) return;
            event.preventDefault();
            fly();
          });
        });

        const render = () => {
          cluster.clearLayers();
          const shown = entries.filter((entry) => !entry.item.hidden);
          cluster.addLayers(shown.map((entry) => entry.marker));

          if (activeId && !shown.some((entry) => entry.id === activeId)) setActive(null);

          // 表示中の全部＋起点が収まるように。0件なら起点だけ映す
          const points: [number, number][] = shown.map((entry) => {
            const { lat, lng } = entry.marker.getLatLng();
            return [lat, lng];
          });
          points.push([origin.lat, origin.lng]);
          if (points.length === 1) map.setView([origin.lat, origin.lng], 13);
          else map.fitBounds(L.latLngBounds(points), { padding: [40, 40] });
        };

        onFilterChange = render;
        render();
      };

      // 地図コンテナが見えるまでライブラリを読み込まない
      const observer = new IntersectionObserver(
        (records) => {
          if (!records.some((record) => record.isIntersecting)) return;
          observer.disconnect();
          loadMap();
        },
        { rootMargin: "200px" }
      );
      observer.observe(canvas);
    }
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .area-map {
    position: relative;
    background-color: #bee0e1;
    padding-top: spx(50);
    padding-bottom: spx(90);
    @include tablet-up {
      padding-top: ppx(80);
      padding-bottom: ppx(120);
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-image: var(--area-paper);
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__inner {
      position: relative;
      z-index: 1;
      margin: 0 auto;
      width: spx(660);
      @include tablet-up {
        width: ppx(2120);
      }
    }

    &__notice {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.7;
      font-size: spx(25);
      margin-bottom: spx(30);
      @include tablet-up {
        font-size: ppx(28);
        margin-bottom: ppx(40);
      }
    }

    // set:html で流し込んだ br にはスコープ属性が付かないので :global で当てる
    // （PageHeader の __br-sp と同じ扱い）
    :global(.area-map__br-sp) {
      display: inline;
      @include tablet-up {
        display: none;
      }
    }

    // SPは地図とチップを1行に詰めて画面上部に貼り付ける。
    // ヘッダー（右上の小さなタブ）は地図の隅に重なるが、地図の隅なら実害がない。
    // 逆にヘッダーを避けて途中の高さに貼り付けると、画面の真ん中に帯が浮いて見づらくなる
    &__panel {
      position: sticky;
      top: 0;
      z-index: 3;
      background-color: #bee0e1;
      // 地図の上に少し余白を残して貼り付ける
      padding-top: spx(26);
      padding-bottom: spx(28);
      @include tablet-up {
        // 中身（地図・チップ）を親のグリッドへそのまま並べ直す
        display: contents;
      }
      @include tablet-only {
        display: block;
        padding-top: ppx(26 * 1.2);
        padding-bottom: ppx(28 * 1.2);
      }

      // ベタ塗りのままだと、紙テクスチャがかかった周囲から浮いて見える。
      // セクションと同じテクスチャを同じ重ね方で敷いて質感をそろえる
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image: var(--area-paper);
        background-repeat: repeat;
        background-position: top left;
        background-size: spx(140);
        mix-blend-mode: luminosity;
        pointer-events: none;
        @include tablet-up {
          content: none;
        }
        @include tablet-only {
          content: "";
          background-size: ppx(200);
        }
      }
    }

    &__filters {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      // 地図とチップがくっついていると押しにくいので上下に余裕を取る
      padding-top: spx(28);
      padding-bottom: spx(6);
      gap: spx(24);
      @include tablet-up {
        grid-area: filters;
        flex-direction: column;
        overflow-x: visible;
        padding-top: 0;
        padding-bottom: 0;
        gap: ppx(16);
      }

      &::-webkit-scrollbar {
        display: none;
      }
    }

    &__filter-group {
      display: flex;

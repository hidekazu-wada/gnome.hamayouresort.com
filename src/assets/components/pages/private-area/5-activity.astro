---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import PaperTexture from "../../../images/common/paper-texture.png";
import IconArrow from "../../../images/common/icon-arrow-white.svg";
import ActivityCard from "../../common/activityCard/ActivityCard.astro";
import { activities } from "../../../../data/activities";
---

<section class="private-activity">
  <!-- 背景の紙テクスチャ -->
  <div
    class="private-activity__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  {/* SPは「で」のあとで折る。空白が入らないよう1行で書く */}
  <h2 class="private-activity__title"><span class="private-activity__title-em">グルキャン・団体</span>で<br class="private-activity__br-sp" />楽しめるアクティビティ</h2>

  <div class="private-activity__slider swiper">
    <ul class="swiper-wrapper">
      {
        activities.map((item) => (
          <li class="private-activity__slide swiper-slide">
            <ActivityCard activity={item} variant="green" />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="private-activity__pagination"></div>

  <a class="private-activity__button" href="/activity/">
    <span class="private-activity__button-label">アクティビティ一覧</span>
    <img class="private-activity__button-icon" src={IconArrow.src} alt="" />
  </a>
</section>

<script>
  import Swiper from "swiper";
  import { Pagination, Autoplay } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  // 自動で動くカルーセルは負担になる人がいるので、視差効果を減らす設定の人には流さない
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ClientRouter未使用のため直接初期化する
  const el = document.querySelector<HTMLElement>(".private-activity__slider");
  if (el) {
    const swiper = new Swiper(el, {
      modules: [Pagination, Autoplay],
      // disableOnInteraction を既定の true にすると、一度スワイプした時点で
      // 自動再生が二度と再開しなくなるので false にしている
      autoplay: reduceMotion
        ? false
        : { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
      loop: true,
      // 設計どおりのカード幅にするため slidesPerView は auto + CSS固定幅
      slidesPerView: "auto",
      spaceBetween: 0,
      centeredSlides: true,
      pagination: { el: ".private-activity__pagination", clickable: true },
      breakpoints: {
        744: { centeredSlides: false },
      },
    });
    // フォント・画像読み込み後に幅を再計測（vw幅の初期計測ずれ対策）
    window.addEventListener("load", () => swiper.update());
  }
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .private-activity {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #bee0e1;
    padding-top: spx(80);
    padding-bottom: spx(90);
    @include tablet-up {
      padding-top: ppx(40);
      padding-bottom: 0;
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    &__title {
      position: relative;
      z-index: 1;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      line-height: 1.5;
      font-size: spx(46);
      letter-spacing: spx(2.3);
      margin-right: spx(-2.3);
      @include tablet-up {
        line-height: 1.8;
        font-size: ppx(47);
        letter-spacing: ppx(2.35);
        margin-right: ppx(-2.35);
      }
    }

    &__title-em {
      color: #507425;
    }

    &__br-sp {
      @include tablet-up {
        display: none;
      }
    }

    // PCは設計どおり4枚（530×4＋間隔10×3）が収まる幅に絞って中央寄せ
    &__slider {
      position: relative;
      z-index: 1;
      width: 100%;
      padding-top: spx(60);
      @include tablet-up {
        width: ppx(2150);
        margin: 0 auto;
        padding-top: ppx(70);
      }
    }

    &__slide {
      display: flex;
      justify-content: center;
      height: auto;
      width: spx(530);
      @include tablet-up {
        width: ppx(530);
        margin-right: ppx(10);
      }
    }

    &__pagination {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: spx(80);
      gap: spx(20);
      @include tablet-up {
        padding-top: ppx(110);
        gap: ppx(20);
      }

      :global(.swiper-pagination-bullet) {
        opacity: 1;
        background-color: #fff;
        margin: 0 !important;
        width: spx(25);
        height: spx(25);
        @include tablet-up {
          width: ppx(30);
          height: ppx(30);
        }
      }

      :global(.swiper-pagination-bullet-active) {
        background-color: #d6b156;
      }
    }

    &__button {
      box-sizing: border-box;
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8aad61;
      border-style: solid;
      border-color: #fff;
      border-radius: 999px;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #fff;
      text-align: center;
      white-space: nowrap;
      transition: background-color 0.3s ease;
      width: spx(496);
      margin-top: spx(60);
      padding: spx(31) 0;
      border-width: spx(4);
      gap: spx(10);
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      @include tablet-up {
        width: ppx(496);
        margin-top: ppx(110);
        padding: ppx(31) 0;
        border-width: ppx(4);
        gap: ppx(10);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      // ホバー: #d6b156にディゾルブ（指示書）
      @include hover {
        &:hover {
          background-color: #d6b156;
        }
      }
    }

    &__button-label {
      margin-right: spx(-1.3);
      @include tablet-up {
        margin-right: ppx(-1.3);
      }
    }

    &__button-icon {
      display: block;
      width: spx(28);
      height: spx(28);
      @include tablet-up {
        width: ppx(28);
        height: ppx(28);
      }
    }
  }
</style>

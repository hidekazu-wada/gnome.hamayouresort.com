---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import Footer from "../footer/Footer.astro";

// アセット
import PaperTexture from "../../../images/common/paper-texture.png";
import LogoBadge from "../../../images/common/logo-badge.svg";
import LogoWordmark from "../../../images/common/footer/logo-wordmark.svg";
import IconArrow from "../../../images/common/icon-arrow.svg";
import IconArrowGreen from "../../../images/common/icon-arrow-green.svg";

// 現在ページの判定（ご予約と同じ金色スタイルをカレント表示に使う）
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href.startsWith("http") || href.includes("#")) return false;
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href.replace(/\/$/, ""));
};

// 過ごし方はケース未指定のためファミリーへ（確定したら差し替え）
const navItems = [
  { label: "TOP", href: "/" },
  { label: "泊まる", href: "/stay/" },
  { label: "アクティビティ", href: "/activity/" },
  { label: "過ごし方", href: "/howto/family/" },
  { label: "共有施設・設備", href: "/facility/" },
  { label: "レンタル・販売品", href: "/rental/" },
  { label: "アクセス", href: "/#access" },
  { label: "FAQ", href: "/faq/" },
  { label: "周辺情報", href: "/area/" },
  { label: "お知らせ", href: "/news/" },
  {
    label: "ご予約",
    href: "https://www.nap-camp.com/yamanashi/13592",
    external: true,
  },
];
---

<div class="menu" id="global-menu">
  <div class="menu__head">
    <!-- 背景の紙テクスチャ -->
    <div
      class="menu__texture"
      aria-hidden="true"
      style={`background-image: url(${PaperTexture.src});`}
    >
    </div>

    <!-- ロゴ（SP=ワードマーク / TB・PC=バッジ） -->
    <a class="menu__logo" href="/">
      <picture class="menu__logo-picture">
        <source srcset={LogoBadge.src} media="(min-width: 744px)" />
        <img
          class="menu__logo-img"
          src={LogoWordmark.src}
          alt="西湖キャンプビレッジ・ノーム"
        />
      </picture>
    </a>

    <nav class="menu__nav">
      <ul class="menu__list">
        {
          navItems.map((item) => (
            <li class="menu__item">
              <a
                class:list={[
                  "menu__link",
                  { "is-current": !item.external && isCurrent(item.href) },
                ]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                aria-current={
                  !item.external && isCurrent(item.href) ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="menu__lead" href="/private-area/">
      <span class="menu__lead-text">企業研修・団体利用・ロケ撮影</span>
      <span class="menu__lead-iconbox">
        <img class="menu__lead-icon" src={IconArrow.src} alt="" />
        <img
          class="menu__lead-icon menu__lead-icon--hover"
          src={IconArrowGreen.src}
          alt=""
        />
      </span>
    </a>
  </div>

  <Footer showTop={false} />
</div>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    overflow-x: clip;
    background-color: #bee0e1;
    // TBは画面が縦に長いときフッターを最下部に貼り付け、
    // 余りはメニュー上部（ナビの下）で吸収する
    @include tablet-up {
      display: flex;
      flex-direction: column;
    }
    @include desktop-up {
      display: block;
    }
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    -webkit-overflow-scrolling: touch;

    // 上部（ロゴ＋ナビ＋企業研修リンク）
    &__head {
      position: relative;
      // テクスチャの mix-blend-mode: luminosity は「下に敷かれた色」と合成するので、
      // 合成相手の背景色は必ずテクスチャの直親に持たせる（他セクションと同じ形）。
      // .menu は fixed + overflow-y:auto + opacity アニメでレイヤー昇格しやすく、
      // 昇格すると合成相手を見失って上半分がグレーになる（Safari・モバイルChrome）
      background-color: #bee0e1;
      isolation: isolate;
      height: spx(930);
      @include tablet-up {
        height: auto;
        min-height: tpx(1599);
        flex: 1 0 auto;
      }
      @include desktop-up {
        height: ppx(770);
        min-height: 0;
        flex: none;
      }
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // ロゴ
    &__logo {
      position: absolute;
      z-index: 1;
      display: block;
      top: spx(50);
      left: spx(50);
      width: spx(229);
      transition: opacity 0.3s ease;
      // ヒーローのロゴ（top/1-hero.astro の &__logo）とまったく同じ位置・大きさにする。
      // 値がずれているとメニューを開いた瞬間にロゴが飛ぶ。SPは元から一致していた。
      // logo-badge.svg は viewBox 602x420 のうち絵が 569.7x388.2（幅の94.6%）で、
      // 残りはドロップシャドウの余白。設計座標（絵の幅694・左上52,75）に合わせるには
      // 箱をその余白ぶん大きく取る必要がある。PageHeader と同じ値にしてある
      @include tablet-up {
        top: ppx(62);
        left: ppx(39);
        width: ppx(734.24);
      }

      @include hover {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    &__logo-picture {
      display: block;
    }

    &__logo-img {
      display: block;
      width: 100%;
      height: auto;
    }

    // ナビゲーション
    &__nav {
      position: absolute;
      z-index: 1;
      top: spx(220);
      left: 50%;
      width: spx(610);
      transform: translateX(-50%);
      // TBは中央寄せの2カラム
      @include tablet-up {
        top: tpx(464);
        left: 50%;
        width: tpx(990);
        transform: translateX(-50%);
      }
      @include desktop-up {
        top: ppx(340);
        left: ppx(906);
        width: ppx(1340);
        transform: none;
      }
    }

    &__list {
      display: flex;
      flex-wrap: wrap;
      gap: spx(15) spx(10);
      @include tablet-up {
        gap: tpx(40) tpx(30);
      }
      @include desktop-up {
        gap: ppx(40) ppx(20);
      }
    }

    &__link {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background-color: #fffdf7;
      color: #507425;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      text-align: center;
      white-space: nowrap;
      transition: opacity 0.3s ease;
      width: spx(300);
      padding: spx(30) spx(40);
      font-size: spx(26);
      line-height: spx(26);
      letter-spacing: spx(1.3);
      box-shadow: 0 spx(10) spx(12) rgba(0, 0, 0, 0.08);
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
      @include tablet-up {
        width: tpx(480);
        padding: tpx(52) tpx(40);
        font-size: tpx(39);
        line-height: tpx(39);
        letter-spacing: tpx(1.95);
        box-shadow: 0 tpx(10) tpx(12) rgba(0, 0, 0, 0.08);
      }
      @include desktop-up {
        width: ppx(320);
        padding: ppx(35) ppx(40);
        font-size: ppx(26);
        line-height: ppx(26);
        letter-spacing: ppx(1.3);
        box-shadow: 0 ppx(10) ppx(12) rgba(0, 0, 0, 0.08);
      }

      // ホバー: 濃い緑にディゾルブ（Figma指定 #507425）
      @include hover {
        &:hover {
          background-color: #507425;
          color: #fffdf7;
        }
      }

      // 現在いるページだけ金色
      &.is-current {
        background-color: #d6b156;
        color: #fffdf7;
      }
    }

    // 企業研修・団体利用・ロケ撮影
    &__lead {
      position: absolute;
      z-index: 1;
      display: flex;
      align-items: center;
      top: spx(869);
      left: spx(105);
      gap: spx(10);
      // TB縦だけヘッダーのInstagramの文字より6.5px高い位置にあったので下げる
      // （PCは3px以内で揃っているので触らない）
      @include tablet-up {
        top: tpx(119);
        left: tpx(1070);
        gap: tpx(10);
      }
      @include desktop-up {
        top: ppx(129);
        left: ppx(1490);
        gap: ppx(10);
      }

      // ホバー: 文字と矢印を緑にディゾルブ（Figma指定 #507425）
      @include hover {
        &:hover {
          .menu__lead-text {
            color: #507425;
          }

          .menu__lead-icon {
            opacity: 0;
          }

          .menu__lead-icon--hover {
            opacity: 1;
          }
        }
      }
    }

    &__lead-text {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      white-space: nowrap;
      transition: color 0.3s ease;
      font-size: spx(32);
      line-height: spx(26);
      letter-spacing: spx(1.6);
      padding-bottom: spx(4);
      @include tablet-up {
        font-size: tpx(30);
        line-height: tpx(26);
        letter-spacing: tpx(1.5);
        padding-bottom: tpx(4);
      }
      @include desktop-up {
        font-size: ppx(32);
        line-height: ppx(26);
        letter-spacing: ppx(1.6);
        padding-bottom: ppx(4);
      }
    }

    &__lead-iconbox {
      position: relative;
      display: block;
      flex-shrink: 0;
      width: spx(30);
      height: spx(30);
      @include tablet-up {
        width: ppx(30);
        height: ppx(30);
      }
    }

    &__lead-icon {
      position: absolute;
      inset: -5%;
      display: block;
      width: 110%;
      height: 110%;
      transition: opacity 0.3s ease;
    }

    &__lead-icon--hover {
      opacity: 0;
    }
  }

  // 開いている状態
  :global(body.is-menu-open) {
    .menu {
      opacity: 1;
      visibility: visible;
    }
  }

  // 背面のスクロールを止める
  :global(body.is-menu-open) {
    overflow-y: hidden;
  }
</style>

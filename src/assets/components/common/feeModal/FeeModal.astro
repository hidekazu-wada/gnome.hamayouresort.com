---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

/**
 * 利用料モーダル（共有施設詳細・企業研修で共通）。
 * 開くボタン側は各ページのデザインが違うので、ここではモーダルだけを持つ。
 * ボタンに data-fee-open="{id}"、このコンポーネントに同じ id を渡すと対応が付く。
 */
interface Props {
  id: string;
  fee: { price: string; notes: string[] };
}

const { id, fee } = Astro.props;
---

<dialog class="fee-modal" data-fee-modal={id} aria-label="利用料">
  <div class="fee-modal__body">
    <div class="fee-modal__row">
      <p class="fee-modal__label">料金</p>
      <p class="fee-modal__value">{fee.price}</p>
    </div>
    <div class="fee-modal__row">
      <p class="fee-modal__label">注意事項</p>
      <ul class="fee-modal__notes">
        {fee.notes.map((note) => <li class="fee-modal__note">・{note}</li>)}
      </ul>
    </div>
  </div>
</dialog>

<script>
  // ClientRouter未使用のため直接初期化する。
  // 1ページに複数のモーダルが並ぶ（企業研修）ので id で結びつける
  document
    .querySelectorAll<HTMLButtonElement>("[data-fee-open]")
    .forEach((btn) => {
      const id = btn.dataset.feeOpen;
      const modal = document.querySelector<HTMLDialogElement>(
        `[data-fee-modal="${id}"]`,
      );
      if (!modal) return;

      btn.addEventListener("click", () => modal.showModal());

      // 背景（dialog自身）クリックで閉じる。中身クリックでは閉じない
      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.close();
      });
    });
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // 施設概要と同じ白カード2枚
  .fee-modal {
    margin: auto;
    border: none;
    outline: none;
    padding: 0;
    background: transparent;
    max-width: none;
    width: spx(630);
    @include tablet-up {
      width: ppx(1800);
    }

    &::backdrop {
      // 0.6 だと背景の見出しや写真が読めてしまい、モーダルの中身が見づらかった
      background: rgba(0, 0, 0, 0.8);
    }

    &__body {
      display: flex;
      flex-direction: column;
      gap: spx(20);
      @include tablet-up {
        gap: ppx(20);
      }
    }

    &__row {
      box-sizing: border-box;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      background-color: #fff;
      width: 100%;
      padding: spx(20) spx(30);
      border-radius: spx(20);
      gap: spx(15);
      @include tablet-up {
        padding: ppx(20) ppx(30);
        border-radius: ppx(20);
        gap: ppx(15);
      }
    }

    &__label {
      flex-shrink: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #138185;
      line-height: 1.6;
      width: spx(150);
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        width: ppx(200);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    &__value {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.6;
      width: spx(405);
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        width: ppx(1525);
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }

    // SPは項目間を1行ぶんあける（Figmaの空行）
    &__notes {
      display: flex;
      flex-direction: column;
      width: spx(405);
      gap: spx(43);
      @include tablet-up {
        width: ppx(1525);
        gap: 0;
      }
    }

    &__note {
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 400;
      color: #000;
      line-height: 1.6;
      word-break: break-all; // ダミーの◯連続を折り返す
      font-size: spx(27);
      letter-spacing: 0;
      @include tablet-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
      }
    }
  }
</style>

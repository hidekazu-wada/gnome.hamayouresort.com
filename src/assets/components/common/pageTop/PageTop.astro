---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

// アセット
import PageTopImg from "../../../images/common/pagetop/page-top.svg";
import PageTopHoverImg from "../../../images/common/pagetop/page-top-hover.svg";
---

<button class="page-top" type="button" aria-label="ページの先頭へ戻る">
  <img class="page-top__img" src={PageTopImg.src} alt="" />
  <img
    class="page-top__img page-top__img--hover"
    src={PageTopHoverImg.src}
    alt=""
  />
</button>

<script>
  const pageTop = document.querySelector<HTMLButtonElement>(".page-top");

  pageTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .page-top {
    position: fixed;
    z-index: 90;
    display: block;
    transition: opacity 0.3s ease;
    right: spx(30);
    bottom: spx(410);
    width: spx(150);
    height: spx(150);
    @include tablet-up {
      right: ppx(60 * 1.2);
      bottom: ppx(250 * 1.2);
      width: ppx(200 * 1.2);
      height: ppx(200 * 1.2);
    }
    @include desktop-up {
      right: ppx(60);
      bottom: ppx(250);
      width: ppx(200);
      height: ppx(200);
    }

    // ホバーで緑（#507425）版にディゾルブ
    @include hover {
      &:hover {
        .page-top__img {
          opacity: 0;
        }

        .page-top__img--hover {
          opacity: 1;
        }
      }
    }

    &__img {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      transition: opacity 0.3s ease;
    }

    &__img--hover {
      opacity: 0;
    }
  }

  // メニューを開いている間は隠す
  :global(body.is-menu-open) {
    .page-top {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

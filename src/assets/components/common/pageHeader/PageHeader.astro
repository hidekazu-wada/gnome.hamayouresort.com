---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

// アセット
import PaperTexture from "../../../images/common/paper-texture.png";
import LogoBadge from "../../../images/common/logo-badge.svg";
import LogoWordmark from "../../../images/common/footer/logo-wordmark.svg";
import CloudPc from "../../../images/common/pageHeader/cloud-pc.svg";
import CloudSp from "../../../images/common/pageHeader/cloud-sp.svg";
import Burst from "../../../images/common/pageHeader/burst.svg";

interface Props {
  /** 英字タイトル（例: ACTIVITY） */
  titleEn: string;
  /** 和文タイトル（例: アクティビティ） */
  titleJa: string;
  /**
   * リード文。改行や強調を含むためHTMLで渡す。省略可。
   * 強調: <span class="page-header__lead-em">〜</span>
   * PCのみの改行: <br class="page-header__br-pc">
   * SPのみの改行: <br class="page-header__br-sp">
   */
  lead?: string;
  /**
   * リード文の見た目。
   * default: 40px（既定） / info: 周辺情報ページ用の小さめ・teal
   * date: お知らせ詳細の日付用 / large: 貸切エリアのキャッチコピー用
   */
  leadVariant?: "default" | "info" | "date" | "large";
  /** SPで英字タイトルが2行になるページ用（高さ700→771。ホテルセットプラン） */
  tallSp?: boolean;
}

const { titleEn, titleJa, lead, leadVariant = "default", tallSp = false } = Astro.props;
---

<div class:list={["page-header", { "page-header--tall-sp": tallSp }]}>
  <!-- 背景の紙テクスチャ -->
  <div
    class="page-header__texture"
    aria-hidden="true"
    style={`background-image: url(${PaperTexture.src});`}
  >
  </div>

  <!-- 雲形の白ベース -->
  <picture class="page-header__cloud">
    <source srcset={CloudPc.src} media="(min-width: 744px)" />
    <img class="page-header__cloud-img" src={CloudSp.src} alt="" />
  </picture>

  <!-- ロゴ（SP=ワードマーク / TB・PC=バッジ） -->
  <a class="page-header__logo" href="/">
    <picture class="page-header__logo-picture">
      <source srcset={LogoBadge.src} media="(min-width: 744px)" />
      <img
        class="page-header__logo-img"
        src={LogoWordmark.src}
        alt="Gnome 湖のほとりのキャンプ場"
      />
    </picture>
  </a>

  <div class="page-header__title">
    <img class="page-header__burst" src={Burst.src} alt="" />
    <div class="page-header__title-body">
      <div class="page-header__title-names">
        <h1 class="page-header__title-en" set:html={titleEn} />
        <p class="page-header__title-ja">{titleJa}</p>
      </div>
      {
        lead && (
          <p
            class:list={[
              "page-header__lead",
              { "page-header__lead--info": leadVariant === "info" },
              { "page-header__lead--date": leadVariant === "date" },
              { "page-header__lead--large": leadVariant === "large" },
            ]}
            set:html={lead}
          />
        )
      }
    </div>
  </div>
</div>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  .page-header {
    position: relative;
    overflow: clip;
    background-color: #bee0e1;
    height: spx(700);
    @include tablet-up {
      height: ppx(804);
    }

    // SPで英字タイトルが2行になるページ（雲や各要素の位置はそのまま）
    &--tall-sp {
      @include sp-only {
        height: spx(771);
      }
    }

    &__texture {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-repeat: repeat;
      background-position: top left;
      background-size: spx(140);
      mix-blend-mode: luminosity;
      pointer-events: none;
      @include tablet-up {
        background-size: ppx(200);
      }
    }

    // 雲形の白ベース
    &__cloud {
      position: absolute;
      z-index: 1;
      display: block;
      top: spx(190);
      left: spx(36);
      width: spx(908);
      height: spx(510);
      @include tablet-up {
        top: 0;
        left: ppx(325.1);
        width: ppx(2234.9);
        height: ppx(804);
      }
    }

    &__cloud-img {
      display: block;
      width: 100%;
      height: 100%;
    }

    // ロゴ
    &__logo {
      position: absolute;
      z-index: 2;
      display: block;
      top: spx(50);
      left: spx(50);
      width: spx(229);
      transition: opacity 0.3s ease;
      // PCはバッジロゴ。SVGに影の余白が含まれるため設計座標から補正する
      @include tablet-up {
        top: ppx(62);
        left: ppx(39);
        width: ppx(734.24);
      }

      @include hover {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    &__logo-picture {
      display: block;
    }

    &__logo-img {
      display: block;
      width: 100%;
      height: auto;
    }

    // タイトル
    &__title {
      position: absolute;
      z-index: 2;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      top: spx(220.25);
      gap: spx(10);
      @include tablet-up {
        top: ppx(159.78);
        gap: ppx(25);
      }
    }

    &__burst {
      display: block;
      width: spx(263);
      height: spx(110);
      @include tablet-up {
        width: ppx(263);
        height: ppx(110);
      }
    }

    &__title-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 700;
      color: #000;
      text-align: center;
      gap: spx(30);
      @include tablet-up {
        gap: ppx(50);
      }
    }

    &__title-names {
      display: flex;
      flex-direction: column;
      align-items: center;
      white-space: nowrap;
      gap: spx(5);
      @include tablet-up {
        gap: ppx(10);
      }
    }

    // letter-spacing は末尾にも入るため、中央寄せがその分だけ左にずれる。
    // 同量のネガティブmarginで打ち消す
    &__title-en {
      line-height: 1.1;
      font-size: spx(79);
      letter-spacing: spx(3.95);
      margin-right: spx(-3.95);
      @include tablet-up {
        font-size: ppx(105);
        letter-spacing: ppx(5.25);
        margin-right: ppx(-5.25);
      }
    }

    &__title-ja {
      line-height: 1.7;
      font-size: spx(26);
      letter-spacing: spx(1.3);
      margin-right: spx(-1.3);
      @include tablet-up {
        font-size: ppx(32);
        letter-spacing: ppx(1.6);
        margin-right: ppx(-1.6);
      }
    }

    // 改行は br で明示する（設計の行幅ちょうどに収まる文字数のため、
    // 自動折り返しに任せると1〜2pxの差で意図しない位置で折れる）
    &__lead {
      white-space: nowrap;
      line-height: 1.6;
      font-size: spx(40);
      letter-spacing: spx(2);
      margin-right: spx(-2);
      @include tablet-up {
        line-height: 1.5;
        font-size: ppx(40);
        letter-spacing: ppx(2);
        margin-right: ppx(-2);
      }

      // 周辺情報ページのリード文は小さめ・teal
      &--info {
        color: #138185;
        line-height: 1.8;
        font-size: spx(26);
        letter-spacing: spx(1.3);
        margin-right: spx(-1.3);
        @include tablet-up {
          line-height: 1.5;
          font-size: ppx(30);
          letter-spacing: ppx(1.5);
          margin-right: ppx(-1.5);
        }
      }

      // お知らせ詳細の日付
      &--date {
        color: #138185;
        line-height: 1.8;
        font-size: spx(26);
        letter-spacing: spx(1.3);
        margin-right: spx(-1.3);
        @include tablet-up {
          line-height: #{ppx(26)};
          font-size: ppx(36);
          letter-spacing: ppx(1.8);
          margin-right: ppx(-1.8);
        }
      }

      // 貸切エリアのキャッチコピー。SPは既定と同じ40px
      &--large {
        @include tablet-up {
          font-size: ppx(55);
          letter-spacing: ppx(2.75);
          margin-right: ppx(-2.75);
        }
      }

      // set:html で差し込むためスコープが付かない
      :global(.page-header__lead-em) {
        color: #d6b156;
      }
    }

    // set:html で差し込むためスコープが付かない（titleEn / lead 共通）
    :global(.page-header__br-pc) {
      display: none;
      @include tablet-up {
        display: inline;
      }
    }

    :global(.page-header__br-sp) {
      display: inline;
      @include tablet-up {
        display: none;
      }
    }
  }
</style>

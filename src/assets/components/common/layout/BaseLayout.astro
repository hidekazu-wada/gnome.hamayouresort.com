---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import Header from "../header/Header.astro";
import Menu from "../menu/Menu.astro";
import Footer from "../footer/Footer.astro";
import PageTop from "../pageTop/PageTop.astro";

interface Props {
  /** <title> に入るページタイトル */
  title?: string;
  /** meta description */
  description?: string;
  /** ヒーローを全面表示するページ（トップ）で固定ヘッダー分の余白を消す */
  flush?: boolean;
  /** パンくず。下層ページでフッター先頭に出す */
  breadcrumb?: { label: string; href?: string }[];
  /** OGP画像。public 直下からのパス。未指定ならサイト共通画像 */
  ogImage?: string;
  /** OGPの種別。お知らせ詳細など記事ページは "article" */
  ogType?: "website" | "article";
}

const SITE_NAME = "西湖キャンプビレッジ・ノーム";
const DEFAULT_DESCRIPTION =
  "西湖のほとりにあるキャンプ場「Gnome」。豊富な宿泊スタイルと20種類以上のアクティビティで、湖畔の自然を楽しめます。";

const {
  title = "西湖キャンプビレッジ・ノーム | 湖のほとりのキャンプ場",
  description = DEFAULT_DESCRIPTION,
  flush = false,
  breadcrumb,
  ogImage = "/og-image.jpg",
  ogType = "website",
} = Astro.props;

// astro.config.mjs の site を基準に絶対URLへ変換する（OGP・canonical は絶対URL必須）
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#8aad61" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <meta name="generator" content={Astro.generator} />
    {/* 【公開前に削除】確認用デプロイのため検索エンジンに載せない */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- フォント Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <Menu />
    <main class:list={["layout-main", { "is-flush": flush }]}>
      <slot />
    </main>
    <Footer breadcrumb={breadcrumb} />
    <PageTop />
  </body>
</html>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // トップページはヒーローを全面表示するため、
  // reset.scss で main に付与される固定ヘッダー分の padding-top を打ち消す
  .layout-main.is-flush {
    padding-top: 0;
  }
</style>

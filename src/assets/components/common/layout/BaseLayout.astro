---
// メインSCSSファイルをインポート
import "../../../../styles/main.scss";

import Header from "../header/Header.astro";
import Menu from "../menu/Menu.astro";
import Footer from "../footer/Footer.astro";
import PageTop from "../pageTop/PageTop.astro";

interface Props {
  /** <title> に入るページタイトル */
  title?: string;
  /** meta description */
  description?: string;
  /** ヒーローを全面表示するページ（トップ）で固定ヘッダー分の余白を消す */
  flush?: boolean;
}

const {
  title = "Gnome | 湖のほとりのキャンプ場",
  description = "",
  flush = false,
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- フォント Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <Menu />
    <main class:list={["layout-main", { "is-flush": flush }]}>
      <slot />
    </main>
    <Footer />
    <PageTop />
  </body>
</html>

<style lang="scss">
  // 必要なmixin/functionをインポート
  @import "../../../../styles/variables";
  @import "../../../../styles/functions";
  @import "../../../../styles/mixins";

  // トップページはヒーローを全面表示するため、
  // reset.scss で main に付与される固定ヘッダー分の padding-top を打ち消す
  .layout-main.is-flush {
    padding-top: 0;
  }
</style>
